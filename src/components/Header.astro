---
// src/components/Header.astro — строка-паспорт: название, навигация, версия и лицензия.
const navLinks = [
  { href: '/', label: 'Главная' },
  { href: '/docs', label: 'Документация' },
  { href: '/tools', label: 'Инструменты' },
  { href: '/roadmap', label: 'Планы' },
  { href: '/security', label: 'Безопасность' },
  { href: '/changelog', label: 'Изменения' },
];
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => currentPath === href || currentPath.startsWith(href + '/');
---

<header class="sticky top-0 z-50 border-b border-line bg-surface-0">
  <div class="mx-auto flex h-10 max-w-[1280px] items-center gap-5 px-6 font-mono text-[10px] uppercase tracking-[0.14em] lg:px-10">

    <a href="/" class="inline-flex min-h-6 shrink-0 items-center text-fg-subtle transition-colors hover:text-fg">
      <span class="text-fg">Validum</span><span class="hidden xl:inline"> · инструмент генерации данных</span>
    </a>

    <nav class="ml-auto hidden items-center gap-3.5 lg:flex xl:gap-4">
      {navLinks.map(link => (
          <a
              href={link.href}
              class:list={[
                "inline-flex min-h-6 items-center transition-colors hover:text-fg",
                isActive(link.href) ? "text-fg" : "text-fg-subtle"
              ]}
              aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
      ))}
    </nav>

    <div class="ml-auto flex items-center gap-2.5 whitespace-nowrap text-fg-subtle lg:ml-0">
      <span class="hidden items-center gap-1.5 sm:flex">
        <span class="inline-block h-1 w-1 rounded-full bg-accent" aria-hidden="true"></span>0.7.0 · maven central · apache 2.0
      </span>
      <span class="hidden text-line sm:inline" aria-hidden="true">·</span>
      <a href="https://github.com/Validum-Tech/validum" target="_blank" rel="noopener noreferrer" class="hidden min-h-6 items-center transition-colors hover:text-fg sm:inline-flex">github ↗</a>

      <details class="group relative lg:hidden">
        <summary class="list-none -mr-2 cursor-pointer p-2 text-fg-subtle transition hover:text-fg" aria-label="Меню">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-open:hidden">
            <line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/>
          </svg>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden group-open:block">
            <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
          </svg>
        </summary>
        <nav class="absolute right-0 top-full z-50 mt-3 flex w-64 flex-col border border-line bg-surface-0 p-2">
          {navLinks.map(link => (
              <a
                  href={link.href}
                  class:list={[
                    "px-3 py-2.5 transition-colors",
                    isActive(link.href) ? "text-fg bg-surface-2" : "text-fg-subtle hover:bg-surface-2 hover:text-fg"
                  ]}
                  aria-current={isActive(link.href) ? 'page' : undefined}
              >
                {link.label}
              </a>
          ))}
          <a href="https://github.com/Validum-Tech/validum" target="_blank" rel="noopener noreferrer" class="mt-1 border-t border-line px-3 pb-2.5 pt-3 text-fg-subtle transition-colors hover:bg-surface-2 hover:text-fg">
            github ↗
          </a>
        </nav>
      </details>
    </div>

  </div>
</header>

<style>
  summary::-webkit-details-marker { display: none; }
  summary { list-style: none; }
</style>
