---
const navLinks = [
  { href: '/', label: 'Главная' },
  { href: '/docs', label: 'Документация' },
  { href: '/architecture', label: 'Архитектура' },
  { href: '/roadmap', label: 'Планы' },
  { href: '/try', label: 'Попробовать' },
  { href: '/security', label: 'Безопасность' },
  { href: '/changelog', label: 'Изменения' },
];
const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 backdrop-blur-md border-b border-line bg-surface-0/80">
  <div class="max-w-[1200px] mx-auto px-6 h-16 flex items-center justify-between">

    <a href="/" class="flex items-center gap-2.5 group shrink-0">
      <div class="w-8 h-8 rounded-full border border-accent flex items-center justify-center transition group-hover:shadow-glow-accent-sm bg-surface-0">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter" class="text-accent">
          <path d="M9 13l3 7 3-7" stroke-width="2.5"/>
          <path d="M9 13L5 9" /><path d="M7 11L3 7" />
          <path d="M5 9L5 4L7 4" /><path d="M3 7L3 3L5 3" />
          <path d="M15 13l4-4" /><path d="M17 11l4-4" />
          <path d="M19 9L19 4L17 4" /><path d="M21 7L21 3L19 3" />
          <circle cx="12" cy="13" r="1" fill="currentColor" stroke="none"/>
        </svg>
      </div>
      <span class="font-semibold text-[15px] tracking-tight">Validum</span>
      <span class="hidden xl:inline text-[11px] font-mono px-1.5 py-0.5 rounded border border-line text-fg-muted">v0.1.0-SNAPSHOT</span>
    </a>

    <nav class="hidden lg:flex items-center gap-4 xl:gap-6">
      {navLinks.map(link => (
          <a
              href={link.href}
              class:list={[
                "text-sm transition-colors hover:text-accent",
                currentPath === link.href ? "text-accent" : "text-fg-muted"
              ]}
          >
            {link.label}
          </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a href="https://github.com/Validum-Tech/validum" target="_blank" class="hidden sm:inline text-sm text-fg-muted hover:text-fg transition">GitHub ↗</a>

      <details class="lg:hidden relative group">
        <summary class="list-none cursor-pointer p-2 -mr-2 text-fg-muted hover:text-fg transition" aria-label="Меню">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-open:hidden">
            <line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/>
          </svg>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden group-open:block">
            <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
          </svg>
        </summary>
        <nav class="absolute right-0 top-full mt-2 w-64 bg-surface-0 border border-line rounded-lg shadow-lg p-2 z-50 flex flex-col">
          {navLinks.map(link => (
              <a
                  href={link.href}
                  class:list={[
                    "text-sm py-2.5 px-3 rounded-md transition-colors",
                    currentPath === link.href ? "text-accent bg-accent/5 font-medium" : "text-fg-muted hover:text-fg hover:bg-surface-3"
                  ]}
              >
                {link.label}
              </a>
          ))}
          <a href="https://github.com/Validum-Tech/validum" target="_blank" class="text-sm py-2.5 px-3 rounded-md text-fg-muted hover:text-fg hover:bg-surface-3 transition-colors border-t border-line mt-1 pt-3">
            GitHub ↗
          </a>
        </nav>
      </details>
    </div>

  </div>
</header>

<style>
  summary::-webkit-details-marker { display: none; }
  summary { list-style: none; }
</style>