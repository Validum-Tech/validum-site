---
const navLinks = [
  { href: '/', label: 'Главная' },
  { href: '/docs', label: 'Документация' },
  { href: '/roadmap', label: 'Roadmap' },
  { href: '/try', label: 'Try it' },
  { href: '/playground', label: 'Playground' },
];
const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 backdrop-blur-md border-b" style="border-color: var(--border-color); background-color: color-mix(in srgb, var(--bg-main) 80%, transparent);">
  <div class="max-w-[1200px] mx-auto px-6 h-16 flex items-center justify-between">

    <a href="/" class="flex items-center gap-2.5 group">
      <div class="w-8 h-8 rounded-full border border-[var(--color-accent)] flex items-center justify-center transition group-hover:shadow-[0_0_15px_rgba(16,185,129,0.4)] bg-[#050505]">
        <!-- V с ветвями -->
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter" class="text-[var(--color-accent)]">
          <path d="M9 13l3 7 3-7" stroke-width="2.5"/>
          <path d="M9 13L5 9" /><path d="M7 11L3 7" />
          <path d="M5 9L5 4L7 4" /><path d="M3 7L3 3L5 3" />
          <path d="M15 13l4-4" /><path d="M17 11l4-4" />
          <path d="M19 9L19 4L17 4" /><path d="M21 7L21 3L19 3" />
          <circle cx="12" cy="13" r="1" fill="currentColor" stroke="none"/>
        </svg>
      </div>
      <span class="font-semibold text-[15px] tracking-tight">Validum</span>
      <span class="text-[11px] font-mono px-1.5 py-0.5 rounded border" style="border-color: var(--border-color); color: var(--text-muted);">v0.1.0</span>
    </a>

    <nav class="hidden md:flex items-center gap-7">
      {navLinks.map(link => (
        <a
          href={link.href}
          class:list={[
            "text-sm transition-colors hover:text-[var(--color-accent)]",
            currentPath === link.href ? "text-[var(--color-accent)]" : "text-[var(--text-muted)]"
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a href="https://github.com/Validum-Tech/validum" target="_blank" class="text-sm text-[var(--text-muted)] hover:text-[var(--text-main)] transition">GitHub ↗</a>

      <button id="theme-toggle" class="p-2 rounded-md hover:bg-black/5 dark:hover:bg-white/5 transition" aria-label="Переключить тему">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden dark:block"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="block dark:hidden"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
      </button>
    </div>

  </div>
</header>

<script is:inline>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const html = document.documentElement;
    html.classList.toggle('dark');
    html.classList.toggle('light');
    localStorage.setItem('validum-theme', html.classList.contains('dark') ? 'dark' : 'light');
  });
</script>