---
// src/components/Footer.astro — та же строка-паспорт, что и в шапке: без рамок и иконок.
import { EXPECTED_TEST_COUNT } from '../lib/content-contract.mjs';

const columns = [
  {
    title: 'Продукт',
    links: [
      { href: '/#quickstart', label: 'Быстрый старт' },
      { href: '/docs', label: 'Документация' },
      { href: '/tools', label: 'Инструменты' },
      { href: '/roadmap', label: 'Планы' },
      { href: '/changelog', label: 'Изменения' },
    ],
  },
  {
    title: 'Ресурсы',
    links: [
      { href: 'https://github.com/Validum-Tech/validum', label: 'GitHub ↗', external: true },
      { href: '/security', label: 'Безопасность' },
      { href: 'https://github.com/Validum-Tech/validum/blob/main/LICENSE', label: 'Лицензия · Apache 2.0 ↗', external: true },
      { href: 'https://github.com/Validum-Tech/validum/releases', label: 'Релизы ↗', external: true },
    ],
  },
];
---

<footer class="border-t border-line bg-surface-0">
  <div class="mx-auto max-w-[1280px] px-6 py-12 lg:px-10">

    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr] md:gap-12">

      <div>
        <div class="font-mono text-[10px] uppercase tracking-[0.2em] text-fg-subtle">
          <span class="text-fg">Validum</span> · инструмент генерации данных
        </div>
        <p class="mt-4 max-w-[26rem] text-sm leading-relaxed text-fg-muted">
          Open-source генератор валидных тестовых данных для российских АБС, банков и финтех-стартапов.
        </p>
        <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 font-mono text-[10px] uppercase tracking-[0.14em] text-fg-subtle">
          <span>Java 17+</span>
          <span class="text-line">·</span>
          <span>Spring Boot 3.5.7</span>
          <span class="text-line">·</span>
          <span>{EXPECTED_TEST_COUNT} tests</span>
        </div>
      </div>

      {columns.map(column => (
        <div>
          <div class="label">{column.title}</div>
          <ul class="mt-3 space-y-1 font-mono text-[12px] tracking-[0.02em]">
            {column.links.map(link => (
              <li>
                <a
                  href={link.href}
                  class="inline-flex min-h-6 items-center text-fg-muted transition-colors hover:text-fg"
                  {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-12 flex flex-col justify-between gap-3 border-t border-line pt-5 font-mono text-[10px] uppercase tracking-[0.14em] text-fg-subtle sm:flex-row">
      <span>© 2026 Validum · все права защищены</span>
      <span>детерминированно · без LLM · без сети</span>
    </div>

  </div>
</footer>
