---
// src/components/home/Security.astro — тот же список строк, что и в «Почему validum».
const items = [
  {
    title: 'Self-hosted',
    text: 'Работает внутри периметра. После сборки Docker-образа интернет не требуется. Никаких outbound-вызовов.',
  },
  {
    title: '152-ФЗ',
    text: 'Все данные синтетические. Не содержат ПДн. Не требуется согласие субъектов, невозможно деанонимизировать.',
  },
  {
    title: 'Zero-dependency core',
    text: 'Ядро не тянет Spring, Datafaker и другие библиотеки. Только JDK 21. Код аудируется за час.',
  },
  {
    title: 'Apache 2.0',
    text: 'Разрешает коммерческое использование, модификацию и форк. Внутренний security-review не требует согласований с правообладателем.',
  },
];
---

<section class="relative border-t border-line py-14 lg:py-16">
  <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
    <div class="grid gap-6 md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] md:items-end">
      <div>
        <p class="kicker">04 / безопасность</p>
        <h2 class="poster-sm mt-4">Для банковского контура</h2>
      </div>
      <p class="text-fg-muted md:pb-2">Сделано так, чтобы пройти review у безопасников и юристов.</p>
    </div>

    <div class="rule mt-8"></div>

    <ul class="mt-0">
      {items.map((item, index) => (
        <li class="grid gap-x-8 gap-y-2 border-b border-line py-6 md:grid-cols-[3rem_minmax(0,1fr)_minmax(0,1fr)] md:items-baseline">
          <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-fg-subtle">0{index + 1}</span>
          <h3 class="text-[19px] font-semibold tracking-tight text-fg">{item.title}</h3>
          <p class="max-w-[38rem] text-sm leading-relaxed text-fg-muted">{item.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
