---
// src/components/home/Hero.astro
import { EXPECTED_REST_ENDPOINTS, EXPECTED_TEST_COUNT } from '../../lib/content-contract.mjs';
---

<section class="relative overflow-hidden pt-20 pb-24 lg:pt-28 lg:pb-32 w-full border-b border-line">

  <div class="absolute inset-0 bg-gradient-to-r from-danger/10 via-surface-0 via-45% to-surface-0 to-55% to-success/10 pointer-events-none -z-10"></div>

  <div class="relative max-w-[1000px] mx-auto px-6 text-center z-30 mb-16">
    <div class="flex justify-center mb-6">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-accent/30 bg-surface-0/80 backdrop-blur text-accent text-xs font-medium">
        <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
        Для АБС, банков и стартапов
      </div>
    </div>

    <h1 class="text-[30px] sm:text-5xl lg:text-[60px] font-bold tracking-tight leading-[1.08] mb-6">
      Данные, которые <span class="text-transparent bg-clip-text bg-gradient-to-r from-accent-dark to-accent-light">проходят валидацию</span>
    </h1>

    <p class="text-base sm:text-lg text-fg-muted leading-relaxed mb-8 max-w-3xl mx-auto">
      ИНН, СНИЛС, ОГРН, БИК, счета по 809-П и паспорта с проверенными контрольными суммами:
      одной командой, воспроизводимо по <span class="font-mono text-accent whitespace-nowrap">--seed</span>
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
      <a href="#quickstart" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-accent hover:bg-accent-light text-accent-fg font-semibold px-8 py-3.5 rounded-lg text-sm transition-all shadow-glow-accent-md">
        Начать работу
      </a>
      <a href="/docs" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 border border-line bg-surface-0/80 backdrop-blur hover:bg-surface-3 px-8 py-3.5 rounded-lg text-sm font-medium transition text-fg">
        Документация
      </a>
    </div>

    <div class="mt-7 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 font-mono text-xs text-fg-subtle">
      <span><span class="text-accent">0</span> зависимостей у ядра</span>
      <span class="hidden sm:inline text-line">·</span>
      <span><span class="text-accent">{EXPECTED_TEST_COUNT}</span> тестов</span>
      <span class="hidden sm:inline text-line">·</span>
      <span><span class="text-accent">{EXPECTED_REST_ENDPOINTS}</span> эндпоинтов REST</span>
    </div>
  </div>

  <!-- Живой вывод CLI: честнее любой анимации -->
  <div class="relative w-full max-w-3xl mx-auto px-6 -mt-4 sm:mt-0 z-20">
    <div class="overflow-hidden rounded-xl border border-line bg-surface-code shadow-glow-accent-sm">
      <div class="flex items-center gap-2 border-b border-line px-4 py-2">
        <span class="h-2.5 w-2.5 rounded-full bg-danger/70"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-metric/70"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-accent/70"></span>
        <span class="ml-2 font-mono text-[11px] text-fg-subtle">validum-cli · терминал</span>
        <span class="ml-auto rounded border border-accent/40 px-1.5 py-0.5 font-mono text-[10px] uppercase tracking-wider text-accent">live</span>
      </div>
      <pre class="overflow-x-auto px-4 py-3 font-mono text-[11px] leading-relaxed sm:text-xs"><code><span class="text-fg-subtle">$</span> java -jar validum.jar generate individual --seed 42 -n 2 <span class="text-fg">--fields</span> personId,fullName,age,inn,snils <span class="text-fg">--format csv</span>
<span class="text-accent"># validum 0.5.0 · seed=42 · asOf=2026-01-15</span>
<span class="text-fg">personId,fullName,age,inn,snils</span>
<span class="text-fg-muted">pd-364c37,Иванов Иван Иванович,34,779370501280,43826479516</span>
<span class="text-fg-muted">pd-a91f03,Петрова Мария Сергеевна,37,500100732259,11234567894</span>
<span class="text-accent animate-pulse">▌</span></code></pre>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1 border-t border-line px-4 py-2 font-mono text-[10px] text-fg-subtle">
        <span><span class="text-accent">✔</span> контрольные суммы сходятся</span>
        <span><span class="text-accent">✔</span> тот же seed → тот же файл (SHA-256)</span>
        <span class="text-metric">906 тестов</span>
      </div>
    </div>
    <p class="mt-3 text-center font-mono text-[11px] text-fg-subtle">
      Реальный вывод CLI: первая строка после команды — метаданные прогона, дальше — данные
    </p>
  </div>

  <div class="relative z-30 text-center mt-6 mb-16">
    <p class="inline-flex flex-col sm:flex-row items-center gap-2 sm:gap-4 text-xs sm:text-sm font-mono text-fg-muted bg-surface-2 border border-line px-4 py-2 rounded-full backdrop-blur">
      <span class="text-danger">Битые данные</span>
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden sm:block opacity-50"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      <span class="text-accent font-bold">Validum исправляет</span>
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden sm:block opacity-50"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      <span class="text-success">Валидный профиль</span>
    </p>
  </div>

  <div class="relative max-w-[1000px] mx-auto px-6 z-30">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="p-4 rounded-xl border border-line bg-surface-2 text-center backdrop-blur hover:border-metric/35 transition">
        <div class="text-metric text-2xl font-bold font-mono mb-1">906</div>
        <div class="text-[11px] text-fg-muted uppercase tracking-wider">тестов</div>
      </div>
      <div class="p-4 rounded-xl border border-line bg-surface-2 text-center backdrop-blur hover:border-metric/35 transition">
        <div class="text-metric text-2xl font-bold font-mono mb-1">~370</div>
        <div class="text-[11px] text-fg-muted uppercase tracking-wider">банков ЦБ</div>
      </div>
      <div class="p-4 rounded-xl border border-line bg-surface-2 text-center backdrop-blur hover:border-metric/35 transition">
        <div class="text-metric text-2xl font-bold font-mono mb-1">19</div>
        <div class="text-[11px] text-fg-muted uppercase tracking-wider">эндпоинтов</div>
      </div>
      <div class="p-4 rounded-xl border border-line bg-surface-2 text-center backdrop-blur hover:border-metric/35 transition">
        <div class="text-metric text-2xl font-bold font-mono mb-1">0</div>
        <div class="text-[11px] text-fg-muted uppercase tracking-wider">зависимостей</div>
      </div>
    </div>
  </div>

  <div class="absolute bottom-6 left-1/2 -translate-x-1/2 animate-bounce z-30">
    <a href="#quickstart" aria-label="Прокрутить вниз">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-fg-muted hover:text-accent transition cursor-pointer">
        <path d="m6 9 6 6 6-6"/>
      </svg>
    </a>
  </div>

</section>

<style>
  @keyframes red-loop {
    0%    { opacity: 1; transform: translateX(0) scale(1); }
    4%    { opacity: 0; transform: translateX(200px) scale(0.3); }
    5%    { opacity: 0; transform: translateX(0) scale(1); }
    7%, 100% { opacity: 1; transform: translateX(0) scale(1); }
  }

  .animate-suck-1 { animation: red-loop 15s ease-in-out infinite; animation-delay: 0s; animation-fill-mode: both; }
  .animate-suck-2 { animation: red-loop 15s ease-in-out infinite; animation-delay: 3s; animation-fill-mode: both; }
  .animate-suck-3 { animation: red-loop 15s ease-in-out infinite; animation-delay: 6s; animation-fill-mode: both; }
  .animate-suck-4 { animation: red-loop 15s ease-in-out infinite; animation-delay: 9s; animation-fill-mode: both; }
  .animate-suck-5 { animation: red-loop 15s ease-in-out infinite; animation-delay: 12s; animation-fill-mode: both; }

  .green-card {
    opacity: 0;
    animation-duration: 15s;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
    animation-fill-mode: both;
  }

  @keyframes push-stack {
    0%   { opacity: 0; transform: translate(-50px, 0) scale(0.8); }
    2%   { opacity: 1; transform: translate(0, 0) scale(1); }
    20%  { opacity: 1; transform: translate(0, 0) scale(1); }
    22%  { opacity: 1; transform: translate(0, 100px) scale(1); }
    40%  { opacity: 1; transform: translate(0, 100px) scale(1); }
    42%  { opacity: 1; transform: translate(0, 200px) scale(1); }
    60%  { opacity: 1; transform: translate(0, 200px) scale(1); }
    62%  { opacity: 1; transform: translate(0, 300px) scale(1); }
    80%  { opacity: 1; transform: translate(0, 300px) scale(1); }
    82%  { opacity: 0; transform: translate(0, 400px) scale(0.8); }
    100% { opacity: 0; transform: translate(0, 400px) scale(0.8); }
  }

  .animate-push-1 { animation-name: push-stack; animation-delay: 0.3s; z-index: 50; }
  .animate-push-2 { animation-name: push-stack; animation-delay: 3.3s; z-index: 40; }
  .animate-push-3 { animation-name: push-stack; animation-delay: 6.3s; z-index: 30; }
  .animate-push-4 { animation-name: push-stack; animation-delay: 9.3s; z-index: 20; }
  .animate-push-5 { animation-name: push-stack; animation-delay: 12.3s; z-index: 10; }

  .perspective-1000 { perspective: 1000px; }
  .backface-hidden { backface-visibility: hidden; }
  .rotate-y-180 { transform: rotateY(180deg); }

  @keyframes flip-coin {
    0% { transform: rotateY(0deg); }
    40% { transform: rotateY(180deg); }
    50% { transform: rotateY(180deg); }
    90% { transform: rotateY(360deg); }
    100% { transform: rotateY(360deg); }
  }

  .animate-flip-coin {
    animation: flip-coin 8s cubic-bezier(0.4, 0, 0.2, 1) infinite;
    transform-style: preserve-3d;
  }
</style>