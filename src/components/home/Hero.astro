---
// src/components/home/Hero.astro — первый экран в стиле V11:
// постерная типографика слева, «прибор» с живой генерацией справа, бегущая строка под ними.
import { EXPECTED_REST_ENDPOINTS, EXPECTED_TEST_COUNT } from '../../lib/content-contract.mjs';

// Проверенные реквизиты для бесконечной ленты: каждое значение сходится по своим правилам.
const stream = [
  { label: 'ИНН', value: '779370501280', check: 'ФНС' },
  { label: 'СНИЛС', value: '43826479516', check: 'ПФР' },
  { label: 'ОГРН', value: '1027700132195', check: 'ФНС' },
  { label: 'Счёт', value: '40817810200006614153', check: '515' },
  { label: 'БИК', value: '044525225', check: 'ED807' },
  { label: 'КПП', value: '773601001', check: 'ФНС' },
  { label: 'Индекс', value: '143500', check: 'КЛАДР' },
  { label: 'Паспорт', value: '4512 345678', check: 'ДУЛ' },
  { label: 'ОКВЭД', value: '62.01', check: 'ОКВЭД-2' },
];

const ticker = [
  'ИНН 779370501280',
  'СНИЛС 43826479516',
  'ОГРН 1027700132195',
  'Счёт 40817810200006614153',
  'КПП 773601001',
  'БИК 044525225',
  'Индекс 143500',
];

const metrics = [
  { value: '0', label: 'зависимостей' },
  { value: EXPECTED_TEST_COUNT, label: 'тестов' },
  { value: EXPECTED_REST_ENDPOINTS, label: 'эндпоинтов REST' },
  { value: '≈370', label: 'банков ЦБ' },
];
---

<section class="relative border-b border-line">
  <div class="mx-auto max-w-[1280px] px-6 pb-12 pt-10 lg:px-10 lg:pb-14 lg:pt-14">
    <div class="grid items-start gap-12 lg:grid-cols-[1.4fr_.9fr] lg:gap-16">

      <!-- Постер -->
      <div>
        <p class="kicker">для АБС, банков и QA-команд</p>
        <h1 class="poster-hero mt-6">
          Не пишите<br />
          генераторы —<br />
          генерируйте<span class="text-accent">.</span>
        </h1>
        <div class="rule mt-8"></div>
        <p class="mt-6 max-w-[36rem] text-[16px] leading-relaxed text-fg-muted sm:text-[17px]">
          Валидно по умолчанию. Воспроизводимо до байта: один seed — тот же набор.
          ИНН, СНИЛС, ОГРН, БИК и счета по 809-П с контрольными суммами, без сети и без LLM.
        </p>

        <div class="mt-9 flex flex-wrap items-center gap-x-7 gap-y-4">
          <a href="#quickstart" class="btn-solid">Начать за 2 минуты</a>
          <a href="/tools/check" class="link-arrow">как проверяются реквизиты →</a>
        </div>
        <p class="mt-4 font-mono text-[11px] uppercase tracking-[0.14em] text-fg-subtle">
          от seed до набора — одна команда · от набора до теста — ноль правок
        </p>

        <!-- Четыре цифры продукта: подпись сверху, число крупно -->
        <div class="mt-12 grid grid-cols-2 gap-px bg-line sm:grid-cols-4">
          {metrics.map((metric) => (
            <div class="bg-surface-0 pt-4">
              <div class="label">{metric.label}</div>
              <div class="mt-2 font-mono text-[26px] leading-none text-fg">{metric.value}</div>
            </div>
          ))}
        </div>
      </div>

      <!-- Прибор: счётчик + бесконечная лента проверенных реквизитов -->
      <div class="hairline relative overflow-hidden bg-surface-1">
        <div class="flex items-center justify-between border-b border-line px-4 py-3 font-mono text-[10px] uppercase tracking-[0.18em] text-fg-subtle">
          <span>генерация · seed 42</span>
          <span class="flex items-center gap-2 text-accent">
            <span class="hero-live h-1.5 w-1.5 rounded-full bg-accent"></span>live
          </span>
        </div>

        <div class="px-4 pb-3 pt-4">
          <div class="num-xl">
            <span id="hero-counter">1 000 000</span><span class="ml-1.5 font-mono text-[13px] text-fg-subtle">строк</span>
          </div>
          <div class="label mt-2">демонстрационный поток, не бенчмарк</div>
        </div>

        <div class="flow-mask h-[189px] overflow-hidden">
          <div class="hero-flow" id="hero-rows">
            {[0, 1].map(() => (
              <div>
                {stream.map((row) => (
                  <div class="grid grid-cols-[68px_minmax(0,1fr)_60px_12px] items-center gap-2 border-b border-line/60 px-4 py-[7px] font-mono text-[11px] text-fg-muted">
                    <span class="text-fg-subtle">{row.label}</span>
                    <span class="truncate text-fg">{row.value}</span>
                    <span class="text-right text-[10px] uppercase tracking-[0.12em] text-fg-subtle">{row.check}</span>
                    <span class="text-right text-accent">✓</span>
                  </div>
                ))}
              </div>
            ))}
          </div>
        </div>

        <div class="grid grid-cols-3 border-t border-line">
          <div class="border-r border-line px-4 py-3">
            <div class="label">отклонено АБС</div>
            <div class="mt-1 font-mono text-[17px] text-fg">0</div>
          </div>
          <div class="border-r border-line px-4 py-3">
            <div class="label">проверок в строке</div>
            <div class="mt-1 font-mono text-[17px] text-fg">6</div>
          </div>
          <div class="px-4 py-3">
            <div class="label">проверок</div>
            <div class="mt-1 font-mono text-[17px] text-fg" id="hero-checks">6 000 000</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Бегущая строка: те же реквизиты, что в продукте -->
    <div class="relative mt-12 overflow-hidden border-y border-line py-3">
      <div class="hero-ticker flex w-max gap-8 whitespace-nowrap font-mono text-[11px] text-fg-subtle">
        {[...ticker, ...ticker].map((item) => (
          <span>{item} <span class="text-accent">✓</span></span>
        ))}
      </div>
    </div>
  </div>

  <style>
    .hero-live {
      animation: heroPulse 2.4s ease-in-out infinite;
    }
    @keyframes heroPulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.3; }
    }

    .hero-flow {
      animation: heroFlow 26s linear infinite;
      will-change: transform;
    }
    @keyframes heroFlow {
      from { transform: translateY(0); }
      to { transform: translateY(-50%); }
    }

    .hero-ticker {
      animation: heroTicker 34s linear infinite;
    }
    @keyframes heroTicker {
      to { transform: translateX(-50%); }
    }

    @media (prefers-reduced-motion: reduce) {
      .hero-flow, .hero-ticker, .hero-live {
        animation: none !important;
      }
    }
  </style>

  <script>
    // Счётчик демонстрационный: темп визуальный, производительность продукта
    // на сайте не заявляется (замеров пока нет). Проверки — производная от счётчика.
    const counter = document.getElementById('hero-counter');
    const checks = document.getElementById('hero-checks');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (counter && !reduced) {
      let value = 1_000_000;
      let last = performance.now();
      const format = (n: number) => n.toLocaleString('ru-RU').replace(/,/g, ' ');

      const tick = (now: number) => {
        const dt = Math.min(now - last, 120);
        last = now;
        value += Math.round((dt / 1000) * 1800);
        counter.textContent = format(value);
        if (checks) checks.textContent = format(value * 6);
        requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }
  </script>
</section>
