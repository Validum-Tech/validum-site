---
// src/components/home/Hero.astro
---

<section class="relative overflow-hidden pt-20 pb-24 lg:pt-28 lg:pb-32 w-full border-b border-line">

  <div class="absolute inset-0 bg-gradient-to-r from-danger/10 via-surface-0 via-45% to-surface-0 to-55% to-success/10 pointer-events-none -z-10"></div>

  <div class="relative max-w-[1000px] mx-auto px-6 text-center z-30 mb-16">
    <div class="flex justify-center mb-6">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-accent/30 bg-surface-0/80 backdrop-blur text-accent text-xs font-medium">
        <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
        Для АБС, банков и стартапов
      </div>
    </div>

    <h1 class="text-4xl sm:text-5xl lg:text-[64px] font-bold tracking-tight leading-[1.1] mb-6">
      Конец рутине.<br>
      Данные, которые <span class="text-transparent bg-clip-text bg-gradient-to-r from-accent-dark to-accent-light">проходят валидацию</span>
    </h1>

    <p class="text-base sm:text-lg text-fg-muted leading-relaxed mb-8 max-w-2xl mx-auto">
      Забудьте про написание классов для генерации клиентов. Получайте готовые, математически валидные профили в один клик.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
      <a href="#quickstart" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-accent hover:bg-accent-light text-accent-fg font-semibold px-8 py-3.5 rounded-lg text-sm transition-all shadow-glow-accent-md">
        Начать работу
      </a>
      <a href="/docs" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 border border-line bg-surface-0/80 backdrop-blur hover:bg-surface-3 px-8 py-3.5 rounded-lg text-sm font-medium transition text-fg">
        Документация
      </a>
    </div>
  </div>

  <div class="relative w-full max-w-[1400px] mx-auto h-[320px] sm:h-[400px] md:h-[500px] z-20 flex justify-between px-1 sm:px-8 md:px-24">

    <!-- ЛЕВАЯ СТОРОНА: Хаос -->
    <div class="relative w-1/2 h-full">

      <!-- 1: Java -->
      <div class="absolute top-[5%] left-[5%] w-[130px] sm:w-[200px] md:w-[260px] h-[55px] sm:h-[75px] md:h-[90px] p-1.5 sm:p-2 md:p-2.5 rounded-xl border border-danger-border bg-danger-surface shadow-glow-danger-sm animate-suck-1 origin-right -rotate-2 overflow-hidden">
        <div class="flex items-center gap-1 text-[6px] sm:text-[8px] md:text-[10px] font-mono text-danger mb-0.5 sm:mb-1 border-b border-danger-border/50 pb-0.5 sm:pb-1">
          <svg xmlns="http://www.w3.org/2000/svg" width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-2 h-2 md:w-3 md:h-3"><path d="M17 8h1a4 4 0 1 1 0 8h-1"/><path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"/><line x1="6" y1="2" x2="6" y2="4"/><line x1="10" y1="2" x2="10" y2="4"/><line x1="14" y1="2" x2="14" y2="4"/></svg>
          ClientGenerator.java
        </div>
        <div class="text-[5px] sm:text-[7px] md:text-[9px] font-mono text-danger/80 leading-tight">
          public Client generate() &#123;<br>
          &nbsp;&nbsp;Client c = new Client();<br>
          &nbsp;&nbsp;c.setInn(InnUtil.random()); <span class="text-danger">// FAIL</span><br>
          &nbsp;&nbsp;... 200 lines of code ...
        </div>
      </div>

      <!-- 2: CSV -->
      <div class="absolute top-[25%] left-[15%] w-[130px] sm:w-[200px] md:w-[260px] h-[55px] sm:h-[75px] md:h-[90px] p-1.5 sm:p-2 md:p-2.5 rounded-xl border border-danger-border bg-danger-surface shadow-glow-danger-sm animate-suck-2 origin-right rotate-1 overflow-hidden">
        <div class="flex items-center gap-1 text-[6px] sm:text-[8px] md:text-[10px] font-mono text-danger mb-0.5 sm:mb-1 border-b border-danger-border/50 pb-0.5 sm:pb-1">
          <svg xmlns="http://www.w3.org/2000/svg" width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-2 h-2 md:w-3 md:h-3"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>
          faker_data.csv
        </div>
        <div class="text-[5px] sm:text-[7px] md:text-[9px] font-mono text-danger/80 leading-tight">
          name,inn,account<br>
          Иван,<span class="line-through">123</span>,<span class="line-through">null</span><br>
          Петр,<span class="line-through">456</span>,<span class="line-through">error</span>
        </div>
      </div>

      <!-- 3: Log -->
      <div class="absolute top-[45%] left-[8%] w-[130px] sm:w-[200px] md:w-[260px] h-[55px] sm:h-[75px] md:h-[90px] p-1.5 sm:p-2 md:p-2.5 rounded-xl border border-danger-border bg-danger-surface shadow-glow-danger-sm animate-suck-3 origin-right -rotate-3 overflow-hidden">
        <div class="flex items-center gap-1 text-[6px] sm:text-[8px] md:text-[10px] font-mono text-danger mb-0.5 sm:mb-1 border-b border-danger-border/50 pb-0.5 sm:pb-1">
          <svg xmlns="http://www.w3.org/2000/svg" width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-2 h-2 md:w-3 md:h-3"><polyline points="4 17 10 11 4 5"/><line x1="12" x2="20" y1="19" y2="19"/></svg>
          Test.log
        </div>
        <div class="text-[5px] sm:text-[7px] md:text-[9px] font-mono text-danger/80 leading-tight">
          <span class="text-danger">Exception:</span> Invalid checksum<br>
          at Abs.validate(Inn.java:42)
        </div>
      </div>

      <!-- 4: XML -->
      <div class="absolute top-[65%] left-[12%] w-[130px] sm:w-[200px] md:w-[260px] h-[55px] sm:h-[75px] md:h-[90px] p-1.5 sm:p-2 md:p-2.5 rounded-xl border border-danger-border bg-danger-surface shadow-glow-danger-sm animate-suck-4 origin-right rotate-2 overflow-hidden">
        <div class="flex items-center gap-1 text-[6px] sm:text-[8px] md:text-[10px] font-mono text-danger mb-0.5 sm:mb-1 border-b border-danger-border/50 pb-0.5 sm:pb-1">
          <svg xmlns="http://www.w3.org/2000/svg" width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-2 h-2 md:w-3 md:h-3"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
          profile.xml
        </div>
        <div class="text-[5px] sm:text-[7px] md:text-[9px] font-mono text-danger/80 leading-tight">
          &lt;client&gt;<br>
          &nbsp;&lt;inn&gt;<span class="line-through">000</span>&lt;/inn&gt;<br>
          &lt;/client&gt;
        </div>
      </div>

      <!-- 5: SQL -->
      <div class="absolute top-[85%] left-[5%] w-[130px] sm:w-[200px] md:w-[260px] h-[55px] sm:h-[75px] md:h-[90px] p-1.5 sm:p-2 md:p-2.5 rounded-xl border border-danger-border bg-danger-surface shadow-glow-danger-sm animate-suck-5 origin-right -rotate-1 overflow-hidden">
        <div class="flex items-center gap-1 text-[6px] sm:text-[8px] md:text-[10px] font-mono text-danger mb-0.5 sm:mb-1 border-b border-danger-border/50 pb-0.5 sm:pb-1">
          <svg xmlns="http://www.w3.org/2000/svg" width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-2 h-2 md:w-3 md:h-3"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5V19A9 3 0 0 0 21 19V5"/><path d="M3 12A9 3 0 0 0 21 12"/></svg>
          insert.sql
        </div>
        <div class="text-[5px] sm:text-[7px] md:text-[9px] font-mono text-danger/80 leading-tight">
          INSERT INTO clients VALUES (<span class="text-danger">NULL</span>...)
        </div>
      </div>

      <div class="absolute top-1/2 left-0 w-[200px] sm:w-[300px] md:w-[400px] h-[200px] sm:h-[300px] md:h-[400px] bg-danger/10 blur-[60px] sm:blur-[80px] md:blur-[100px] -translate-y-1/2 rounded-full pointer-events-none"></div>
    </div>

    <!-- ЦЕНТР: 3D Медальон -->
    <div class="absolute left-1/2 top-0 bottom-0 w-px md:w-[2px] -translate-x-1/2 flex flex-col justify-center items-center z-30">
      <div class="w-full h-full bg-gradient-to-b from-transparent via-accent to-transparent shadow-glow-accent-xl opacity-80"></div>

      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 z-40 perspective-1000">
        <div class="relative w-16 h-16 sm:w-20 sm:h-20 md:w-28 md:h-28 animate-flip-coin">

          <div class="absolute inset-0 backface-hidden flex items-center justify-center rounded-full bg-surface-0 border-2 border-accent shadow-glow-accent-lg">
            <div class="absolute inset-1 rounded-full border border-accent/20"></div>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-accent w-8 h-8 sm:w-10 sm:h-10 md:w-12 md:h-12">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" fill="currentColor" fill-opacity="0.1"/>
              <path d="M8 11l3 3 5-5" stroke-width="2.5" stroke-linecap="square"/>
            </svg>
          </div>

          <div class="absolute inset-0 backface-hidden flex items-center justify-center rounded-full bg-surface-0 border-2 border-accent shadow-glow-accent-lg rotate-y-180">
            <div class="absolute inset-1.5 rounded-full border border-accent/20"></div>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter" class="text-accent z-10 w-8 h-8 sm:w-10 sm:h-10 md:w-12 md:h-12">
              <path d="M9 13l3 7 3-7" stroke-width="2.5"/>
              <path d="M9 13L5 9" /><path d="M7 11L3 7" />
              <path d="M5 9L5 4L7 4" /><path d="M3 7L3 3L5 3" />
              <path d="M15 13l4-4" /><path d="M17 11l4-4" />
              <path d="M19 9L19 4L17 4" /><path d="M21 7L21 3L19 3" />
              <circle cx="12" cy="13" r="1" fill="currentColor" stroke="none"/>
            </svg>
          </div>

        </div>
        <div class="absolute inset-0 rounded-full border-2 border-accent animate-ping opacity-20 pointer-events-none"></div>
      </div>
    </div>

    <!-- ПРАВАЯ СТОРОНА: Стопка -->
    <div class="relative w-1/2 h-full">

      <div class="absolute top-1/2 right-[10%] -translate-y-1/2 w-[130px] sm:w-[200px] md:w-[280px] h-[275px] sm:h-[375px] md:h-[400px]">

        <!-- 1: Java -->
        <div class="absolute top-0 w-full h-[55px] sm:h-[75px] md:h-[90px] p-1.5 sm:p-2 md:p-2.5 rounded-xl border border-accent/60 bg-success-surface shadow-glow-success-sm green-card animate-push-1 overflow-hidden">
          <div class="absolute -top-1.5 -right-1.5 md:-top-2 md:-right-2 w-4 h-4 md:w-6 md:h-6 rounded-full bg-accent flex items-center justify-center shadow-lg">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="var(--accent-fg)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="w-2 h-2 md:w-3 md:h-3"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
          <div class="flex items-center gap-1 text-[6px] sm:text-[8px] md:text-[10px] font-mono text-accent mb-0.5 sm:mb-1 border-b border-accent/20 pb-0.5 sm:pb-1">
            <svg xmlns="http://www.w3.org/2000/svg" width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-2 h-2 md:w-3 md:h-3"><path d="M17 8h1a4 4 0 1 1 0 8h-1"/><path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"/><line x1="6" y1="2" x2="6" y2="4"/><line x1="10" y1="2" x2="10" y2="4"/><line x1="14" y1="2" x2="14" y2="4"/></svg>
            IndividualProfile.java
          </div>
          <div class="text-[5px] sm:text-[7px] md:text-[9px] font-mono text-accent/90 leading-tight">
            IndividualProfile p = Validum<br>
            &nbsp;&nbsp;.generate(Individual.class);<br>
            <span class="text-fg-muted">// p.getInn() → "427624447300"</span>
          </div>
        </div>

        <!-- 2: JSON -->
        <div class="absolute top-0 w-full h-[55px] sm:h-[75px] md:h-[90px] p-1.5 sm:p-2 md:p-2.5 rounded-xl border border-accent/40 bg-success-surface shadow-glow-success-sm green-card animate-push-2 overflow-hidden">
          <div class="flex items-center gap-1 text-[6px] sm:text-[8px] md:text-[10px] font-mono text-accent mb-0.5 sm:mb-1 border-b border-accent/20 pb-0.5 sm:pb-1">
            <svg xmlns="http://www.w3.org/2000/svg" width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-2 h-2 md:w-3 md:h-3"><path d="M8 3H7a2 2 0 0 0-2 2v5a2 2 0 0 1-2 2 2 2 0 0 1 2 2v5c0 1.1.9 2 2 2h1"/><path d="M16 21h1a2 2 0 0 0 2-2v-5c0-1.1.9-2 2-2a2 2 0 0 1-2-2V5a2 2 0 0 0-2-2h-1"/></svg>
            response.json
          </div>
          <div class="text-[5px] sm:text-[7px] md:text-[9px] font-mono text-fg/90 leading-tight">
            &#123;<br>
            &nbsp;&nbsp;"inn": "427624447300",<br>
            &nbsp;&nbsp;"snils": "112-233-445 95"<br>
            &#125;
          </div>
        </div>

        <!-- 3: CSV -->
        <div class="absolute top-0 w-full h-[55px] sm:h-[75px] md:h-[90px] p-1.5 sm:p-2 md:p-2.5 rounded-xl border border-accent/30 bg-success-surface shadow-glow-success-sm green-card animate-push-3 overflow-hidden">
          <div class="flex items-center gap-1 text-[6px] sm:text-[8px] md:text-[10px] font-mono text-accent mb-0.5 sm:mb-1 border-b border-accent/20 pb-0.5 sm:pb-1">
            <svg xmlns="http://www.w3.org/2000/svg" width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-2 h-2 md:w-3 md:h-3"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>
            export.csv
          </div>
          <div class="text-[5px] sm:text-[7px] md:text-[9px] font-mono text-fg-muted leading-tight">
            fullName,inn,snils<br>
            Зайцев Г.,427624447300,...
          </div>
        </div>

        <!-- 4: XML -->
        <div class="absolute top-0 w-full h-[55px] sm:h-[75px] md:h-[90px] p-1.5 sm:p-2 md:p-2.5 rounded-xl border border-accent/20 bg-success-surface shadow-glow-success-sm green-card animate-push-4 overflow-hidden">
          <div class="flex items-center gap-1 text-[6px] sm:text-[8px] md:text-[10px] font-mono text-accent mb-0.5 sm:mb-1 border-b border-accent/20 pb-0.5 sm:pb-1">
            <svg xmlns="http://www.w3.org/2000/svg" width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-2 h-2 md:w-3 md:h-3"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
            profile.xml
          </div>
          <div class="text-[5px] sm:text-[7px] md:text-[9px] font-mono text-fg-muted leading-tight">
            &lt;client&gt;<br>
            &nbsp;&lt;inn&gt;427624447300&lt;/inn&gt;<br>
            &lt;/client&gt;
          </div>
        </div>

        <!-- 5: SQL -->
        <div class="absolute top-0 w-full h-[55px] sm:h-[75px] md:h-[90px] p-1.5 sm:p-2 md:p-2.5 rounded-xl border border-accent/10 bg-success-surface shadow-glow-success-sm green-card animate-push-5 overflow-hidden">
          <div class="flex items-center gap-1 text-[6px] sm:text-[8px] md:text-[10px] font-mono text-accent mb-0.5 sm:mb-1 border-b border-accent/20 pb-0.5 sm:pb-1">
            <svg xmlns="http://www.w3.org/2000/svg" width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-2 h-2 md:w-3 md:h-3"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5V19A9 3 0 0 0 21 19V5"/><path d="M3 12A9 3 0 0 0 21 12"/></svg>
            insert.sql
          </div>
          <div class="text-[5px] sm:text-[7px] md:text-[9px] font-mono text-fg-subtle leading-tight">
            INSERT INTO clients VALUES<br>
            ('427624447300', '112233...');
          </div>
        </div>

      </div>

      <div class="absolute top-1/2 right-0 w-[200px] sm:w-[300px] md:w-[400px] h-[200px] sm:h-[300px] md:h-[400px] bg-success/10 blur-[60px] sm:blur-[80px] md:blur-[100px] -translate-y-1/2 rounded-full pointer-events-none"></div>
    </div>

  </div>

  <div class="relative z-30 text-center mt-6 mb-16">
    <p class="inline-flex flex-col sm:flex-row items-center gap-2 sm:gap-4 text-xs sm:text-sm font-mono text-fg-muted bg-surface-2 border border-line px-4 py-2 rounded-full backdrop-blur">
      <span class="text-danger">Битые данные</span>
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden sm:block opacity-50"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      <span class="text-accent font-bold">Validum исправляет</span>
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden sm:block opacity-50"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      <span class="text-success">Валидный профиль</span>
    </p>
  </div>

  <div class="relative max-w-[1000px] mx-auto px-6 z-30">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="p-4 rounded-xl border border-line bg-surface-2 text-center backdrop-blur hover:border-accent/30 transition">
        <div class="text-accent text-2xl font-bold font-mono mb-1">721</div>
        <div class="text-[11px] text-fg-muted uppercase tracking-wider">тестов</div>
      </div>
      <div class="p-4 rounded-xl border border-line bg-surface-2 text-center backdrop-blur hover:border-accent/30 transition">
        <div class="text-accent text-2xl font-bold font-mono mb-1">370</div>
        <div class="text-[11px] text-fg-muted uppercase tracking-wider">банков ЦБ</div>
      </div>
      <div class="p-4 rounded-xl border border-line bg-surface-2 text-center backdrop-blur hover:border-accent/30 transition">
        <div class="text-accent text-2xl font-bold font-mono mb-1">19</div>
        <div class="text-[11px] text-fg-muted uppercase tracking-wider">эндпоинтов</div>
      </div>
      <div class="p-4 rounded-xl border border-line bg-surface-2 text-center backdrop-blur hover:border-accent/30 transition">
        <div class="text-accent text-2xl font-bold font-mono mb-1">0</div>
        <div class="text-[11px] text-fg-muted uppercase tracking-wider">зависимостей</div>
      </div>
    </div>
  </div>

  <div class="absolute bottom-6 left-1/2 -translate-x-1/2 animate-bounce z-30">
    <a href="#quickstart" aria-label="Прокрутить вниз">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-fg-muted hover:text-accent transition cursor-pointer">
        <path d="m6 9 6 6 6-6"/>
      </svg>
    </a>
  </div>

</section>

<style>
  @keyframes red-loop {
    0%    { opacity: 1; transform: translateX(0) scale(1); }
    4%    { opacity: 0; transform: translateX(200px) scale(0.3); }
    5%    { opacity: 0; transform: translateX(0) scale(1); }
    7%, 100% { opacity: 1; transform: translateX(0) scale(1); }
  }

  .animate-suck-1 { animation: red-loop 15s ease-in-out infinite; animation-delay: 0s; animation-fill-mode: both; }
  .animate-suck-2 { animation: red-loop 15s ease-in-out infinite; animation-delay: 3s; animation-fill-mode: both; }
  .animate-suck-3 { animation: red-loop 15s ease-in-out infinite; animation-delay: 6s; animation-fill-mode: both; }
  .animate-suck-4 { animation: red-loop 15s ease-in-out infinite; animation-delay: 9s; animation-fill-mode: both; }
  .animate-suck-5 { animation: red-loop 15s ease-in-out infinite; animation-delay: 12s; animation-fill-mode: both; }

  .green-card {
    opacity: 0;
    animation-duration: 15s;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
    animation-fill-mode: both;
  }

  @keyframes push-stack {
    0%   { opacity: 0; transform: translate(-50px, 0) scale(0.8); }
    2%   { opacity: 1; transform: translate(0, 0) scale(1); }
    20%  { opacity: 1; transform: translate(0, 0) scale(1); }
    22%  { opacity: 1; transform: translate(0, 100px) scale(1); }
    40%  { opacity: 1; transform: translate(0, 100px) scale(1); }
    42%  { opacity: 1; transform: translate(0, 200px) scale(1); }
