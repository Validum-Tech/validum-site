---
// src/components/home/QuickStart.astro
---

<section id="quickstart" class="relative py-24 border-t border-line">
    <div class="max-w-[1000px] mx-auto px-6">
        <div class="mb-12 text-center">
            <div class="text-xs font-mono text-accent tracking-widest mb-3 uppercase">01 / Быстрый старт</div>
            <h2 class="text-3xl sm:text-4xl font-bold tracking-tight mb-4">Начните за 2 минуты</h2>
            <p class="text-fg-muted">Соберите локально и запустите. Без интернета после сборки.</p>
        </div>

        <div class="rounded-2xl border border-line bg-surface-2 overflow-hidden">

            <div class="flex items-center border-b border-line bg-surface-1 px-2 pt-2">
                <button class="tab-btn active px-6 py-3 text-sm font-medium rounded-t-lg transition-colors border-b-2 border-accent text-accent bg-surface-0" data-tab="cli">CLI</button>
                <button class="tab-btn px-6 py-3 text-sm font-medium text-fg-muted hover:text-fg border-b-2 border-transparent transition-colors" data-tab="docker">Docker</button>
                <button class="tab-btn px-6 py-3 text-sm font-medium text-fg-muted hover:text-fg border-b-2 border-transparent transition-colors" data-tab="rest">REST API</button>
            </div>

            <div class="p-6 relative">
                <div class="tab-content block" data-content="cli">
                    <div class="relative group">
                        <button class="copy-btn absolute top-3 right-3 px-2.5 py-1.5 text-xs font-mono text-fg-muted bg-surface-2 hover:bg-surface-3 rounded transition opacity-0 group-hover:opacity-100 border border-line" data-copy>Copy</button>
                        <pre class="text-[13px] font-mono text-fg bg-code p-5 rounded-xl border border-line overflow-x-auto leading-relaxed"><code class="language-bash">git clone https://github.com/Validum-Tech/validum.git
cd validum && ./gradlew :validum-cli:shadowJar

java -jar validum-cli/build/libs/validum.jar \
  generate individual --count 100 --seed 42 --format csv > profiles.csv</code></pre>
                    </div>
                </div>

                <div class="tab-content hidden" data-content="docker">
                    <div class="relative group">
                        <button class="copy-btn absolute top-3 right-3 px-2.5 py-1.5 text-xs font-mono text-fg-muted bg-surface-2 hover:bg-surface-3 rounded transition opacity-0 group-hover:opacity-100 border border-line" data-copy>Copy</button>
                        <pre class="text-[13px] font-mono text-fg bg-code p-5 rounded-xl border border-line overflow-x-auto leading-relaxed"><code class="language-bash">git clone https://github.com/Validum-Tech/validum.git
cd validum
docker build -f validum-api/Dockerfile -t validum-api .
docker run -d -p 8080:8080 validum-api</code></pre>
                    </div>
                </div>

                <div class="tab-content hidden" data-content="rest">
                    <div class="relative group">
                        <button class="copy-btn absolute top-3 right-3 px-2.5 py-1.5 text-xs font-mono text-fg-muted bg-surface-2 hover:bg-surface-3 rounded transition opacity-0 group-hover:opacity-100 border border-line" data-copy>Copy</button>
                        <pre class="text-[13px] font-mono text-fg bg-code p-5 rounded-xl border border-line overflow-x-auto leading-relaxed"><code class="language-bash">curl -X POST http://localhost:8080/api/v1/generate/individual \
  -H "Content-Type: application/json" \
  -d '&#123;"seed": 42, "age": 35, "region": "MOSCOW"&#125;'</code></pre>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    document.querySelectorAll<HTMLElement>('.tab-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            const tab = btn.dataset.tab;

            document.querySelectorAll<HTMLElement>('.tab-btn').forEach(b => {
                b.classList.remove('active', 'text-accent', 'border-accent', 'bg-surface-0');
                b.classList.add('text-fg-muted', 'border-transparent');
            });

            btn.classList.add('active', 'text-accent', 'border-accent', 'bg-surface-0');
            btn.classList.remove('text-fg-muted', 'border-transparent');

            document.querySelectorAll<HTMLElement>('.tab-content').forEach(c => {
                if (c.dataset.content === tab) {
                    c.classList.remove('hidden');
                    c.classList.add('block');
                } else {
                    c.classList.add('hidden');
                    c.classList.remove('block');
                }
            });
        });
    });

    document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach(btn => {
        btn.addEventListener('click', () => {
            const code = btn.parentElement?.querySelector<HTMLElement>('code');
            if (code) {
                navigator.clipboard.writeText(code.innerText).then(() => {
                    btn.innerText = 'Copied!';
                    setTimeout(() => { btn.innerText = 'Copy'; }, 2000);
                });
            }
        });
    });
</script>