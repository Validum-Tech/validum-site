---
// src/components/home/QuickStart.astro — редакционная подача: номер, линия, волосяная рамка.
---

<section id="quickstart" class="relative border-t border-line py-14 lg:py-16">
  <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
    <div class="grid gap-6 md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] md:items-end">
      <div>
        <p class="kicker">01 / быстрый старт</p>
        <h2 class="poster-sm mt-4">Начните за 2 минуты</h2>
      </div>
      <p class="text-fg-muted md:pb-2">Соберите локально и запустите. Без интернета после сборки.</p>
    </div>

    <div class="rule mt-8"></div>

    <div class="mt-8 hairline overflow-hidden">
      <div class="flex items-center gap-1 border-b border-line px-2 pt-2">
        <button type="button" class="tab-btn active border-b-2 border-accent px-5 py-3 font-mono text-[11px] uppercase tracking-[0.14em] text-accent transition-colors" data-tab="cli">CLI</button>
        <button type="button" class="tab-btn border-b-2 border-transparent px-5 py-3 font-mono text-[11px] uppercase tracking-[0.14em] text-fg-subtle transition-colors hover:text-fg" data-tab="docker">Docker</button>
        <button type="button" class="tab-btn border-b-2 border-transparent px-5 py-3 font-mono text-[11px] uppercase tracking-[0.14em] text-fg-subtle transition-colors hover:text-fg" data-tab="rest">REST API</button>
      </div>

      <div class="relative p-0">
        <div class="tab-content block" data-content="cli">
          <div class="group relative">
            <button type="button" class="copy-btn absolute right-3 top-3 rounded-sm border border-line bg-surface-2 px-2 py-1 font-mono text-[10px] uppercase tracking-[0.12em] text-fg-subtle opacity-0 transition hover:bg-surface-3 hover:text-fg group-hover:opacity-100" data-copy>Copy</button>
            <pre class="overflow-x-auto bg-code px-5 py-5 font-mono text-[13px] leading-relaxed text-fg"><code class="language-bash">git clone https://github.com/Validum-Tech/validum.git
cd validum &amp;&amp; ./gradlew :validum-cli:shadowJar

java -jar validum-cli/build/libs/validum.jar \
  generate individual --count 100 --seed 42 --format csv > profiles.csv</code></pre>
          </div>
        </div>

        <div class="tab-content hidden" data-content="docker">
          <div class="group relative">
            <button type="button" class="copy-btn absolute right-3 top-3 rounded-sm border border-line bg-surface-2 px-2 py-1 font-mono text-[10px] uppercase tracking-[0.12em] text-fg-subtle opacity-0 transition hover:bg-surface-3 hover:text-fg group-hover:opacity-100" data-copy>Copy</button>
            <pre class="overflow-x-auto bg-code px-5 py-5 font-mono text-[13px] leading-relaxed text-fg"><code class="language-bash">git clone https://github.com/Validum-Tech/validum.git
cd validum
docker build -f validum-api/Dockerfile -t validum-api .
docker run -d -p 8080:8080 validum-api</code></pre>
          </div>
        </div>

        <div class="tab-content hidden" data-content="rest">
          <div class="group relative">
            <button type="button" class="copy-btn absolute right-3 top-3 rounded-sm border border-line bg-surface-2 px-2 py-1 font-mono text-[10px] uppercase tracking-[0.12em] text-fg-subtle opacity-0 transition hover:bg-surface-3 hover:text-fg group-hover:opacity-100" data-copy>Copy</button>
            <pre class="overflow-x-auto bg-code px-5 py-5 font-mono text-[13px] leading-relaxed text-fg"><code class="language-bash">curl -X POST http://localhost:8080/api/v1/generate/individual \
  -H "Content-Type: application/json" \
  -d '&#123;"seed": 42, "age": 35, "region": "MOSCOW"&#125;'</code></pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const tab = btn.dataset.tab;

      document.querySelectorAll<HTMLElement>('.tab-btn').forEach(b => {
        b.classList.remove('active', 'text-accent', 'border-accent');
        b.classList.add('text-fg-subtle', 'border-transparent');
      });

      btn.classList.add('active', 'text-accent', 'border-accent');
      btn.classList.remove('text-fg-subtle', 'border-transparent');

      document.querySelectorAll<HTMLElement>('.tab-content').forEach(c => {
        if (c.dataset.content === tab) {
          c.classList.remove('hidden');
          c.classList.add('block');
        } else {
          c.classList.add('hidden');
          c.classList.remove('block');
        }
      });
    });
  });

  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach(btn => {
    btn.addEventListener('click', () => {
      const code = btn.parentElement?.querySelector<HTMLElement>('code');
      if (code) {
        navigator.clipboard.writeText(code.innerText).then(() => {
          btn.innerText = 'Copied!';
          setTimeout(() => { btn.innerText = 'Copy'; }, 2000);
        });
      }
    });
  });
</script>
