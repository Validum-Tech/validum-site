---
// src/components/home/Comparison.astro — контраст «до / после»: две колонки-колонки с вердиктом и таблица деталей.

// Одна и та же строка до и после Validum — наглядная иллюстрация к таблице.
const badRows = [
  { label: 'ИНН', value: '779370501281', why: 'контрольная сумма' },
  { label: 'СНИЛС', value: '43826479517', why: 'контрольное число' },
  { label: 'Счёт', value: '40817810200006614154', why: 'ключ по письму 515' },
  { label: 'Индекс', value: '604831', why: 'чужой регион' },
];

const goodRows = [
  { label: 'ИНН', value: '779370501280', why: 'ФНС' },
  { label: 'СНИЛС', value: '43826479516', why: 'ПФР' },
  { label: 'Счёт', value: '40817810200006614153', why: 'письмо 515' },
  { label: 'Индекс', value: '143500', why: 'КЛАДР' },
];

const rows = [
  { criteria: "ИНН / СНИЛС / счёт по 809-П", faker: "✗ не сходятся", validum: "✓ по алгоритмам ФНС / ПФР / ЦБ" },
  { criteria: "БИК из справочника ЦБ", faker: "✗ случайные цифры", validum: "✓ около 370 банков из ED807" },
  { criteria: "Каскады (age → паспорт)", faker: "✗ нет каскадов", validum: "✓ выдан в 14, статус меняется" },
  { criteria: "Self-hosted", faker: "! облако / SaaS", validum: "✓ Docker, без интернета" },
  { criteria: "152-ФЗ", faker: "! зависит от данных", validum: "✓ чистая синтетика" },
  { criteria: "Zero-dep core", faker: "✗ тянет библиотеки", validum: "✓ только JDK 21" },
];
---

<section class="relative border-t border-line py-14 lg:py-16">
  <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
    <div class="grid gap-6 md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] md:items-end">
      <div>
        <p class="kicker">03 / сравнение</p>
        <h2 class="poster-sm mt-4">Почему не Faker</h2>
      </div>
      <p class="text-fg-muted md:pb-2">Faker и Mockaroo дают «похожие» данные. Validum даёт валидные. Разница — в том, что проходит в АБС.</p>
    </div>

    <div class="rule mt-8"></div>

    <!-- Наглядно: та же строка до и после Validum -->
    <div class="mt-10 grid gap-x-10 gap-y-10 md:grid-cols-2">

      <div class="border-t-2 border-danger/60 pt-5">
        <div class="flex items-baseline justify-between gap-3">
          <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-fg-subtle">faker · mockaroo</span>
          <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-danger">отклонит АБС</span>
        </div>
        <div class="mt-4 flex items-baseline gap-3">
          <span class="font-mono text-[44px] leading-none text-danger">0</span>
          <span class="font-mono text-[13px] uppercase tracking-[0.14em] text-fg-subtle">из 4 реквизитов пройдут</span>
        </div>
        <ul class="mt-5 font-mono text-[12px]">
          {badRows.map((row) => (
            <li class="grid grid-cols-[64px_minmax(0,1fr)_auto] items-baseline gap-3 border-b border-line py-2.5 last:border-0">
              <span class="text-fg-subtle">{row.label}</span>
              <span class="truncate text-danger">{row.value}</span>
              <span class="text-[10px] uppercase tracking-[0.1em] text-danger/70">{row.why}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="border-t-2 border-accent pt-5">
        <div class="flex items-baseline justify-between gap-3">
          <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-fg-subtle">validum · seed 42</span>
          <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-accent">сходится</span>
        </div>
        <div class="mt-4 flex items-baseline gap-3">
          <span class="font-mono text-[44px] leading-none text-accent">4</span>
          <span class="font-mono text-[13px] uppercase tracking-[0.14em] text-fg-subtle">из 4 реквизитов пройдут</span>
        </div>
        <ul class="mt-5 font-mono text-[12px]">
          {goodRows.map((row) => (
            <li class="grid grid-cols-[64px_minmax(0,1fr)_auto] items-baseline gap-3 border-b border-line py-2.5 last:border-0">
              <span class="text-fg-subtle">{row.label}</span>
              <span class="truncate text-fg">{row.value}</span>
              <span class="flex items-baseline gap-1.5 text-[10px] uppercase tracking-[0.1em] text-fg-subtle">
                {row.why}
                <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="text-accent" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg>
              </span>
            </li>
          ))}
        </ul>
      </div>

    </div>

    <div class="rule mt-12"></div>

    <!-- Desktop: таблица (>= md) -->
    <div class="hidden md:block">
      <table class="w-full border-collapse text-left text-sm">
        <thead>
          <tr class="border-b border-line">
            <th class="label py-4 pr-6 font-normal">Критерий</th>
            <th class="label py-4 pr-6 font-normal">Faker / Mockaroo</th>
            <th class="label py-4 font-normal">Validum</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr class="border-b border-line transition-colors last:border-0 hover:bg-surface-1">
              <td class="py-4 pr-6 font-medium">{row.criteria}</td>
              <td class="py-4 pr-6 font-mono text-[12px] text-danger/85">{row.faker}</td>
              <td class="py-4 font-mono text-[12px] text-fg-muted">{row.validum}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Mobile: строки-карточки (< md) -->
    <div class="mt-6 space-y-px bg-line md:hidden">
      {rows.map(row => (
        <div class="bg-surface-0 py-5">
          <div class="font-medium">{row.criteria}</div>
          <div class="mt-3 flex items-baseline gap-3 font-mono text-[12px]">
            <span class="label w-14 shrink-0">faker</span>
            <span class="text-danger/85">{row.faker}</span>
          </div>
          <div class="mt-2 flex items-baseline gap-3 font-mono text-[12px]">
            <span class="label w-14 shrink-0">validum</span>
            <span class="text-fg-muted">{row.validum}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
