---
// src/components/home/Features.astro — список строк на волосяных линиях: номер, заголовок, пояснение.
const items = [
  {
    title: 'Контрольные суммы сходятся',
    text: 'ИНН, СНИЛС, ОГРН и счета по 809-П генерируются по алгоритмам ФНС, ПФР и ЦБ РФ — контрольные суммы сходятся, номер счёта проходит проверку по письму 515.',
  },
  {
    title: 'Каскадные дефолты',
    text: 'Задал age=16 — паспорт выдан в 14 лет, статус «Действительный». Всё логично связано.',
  },
  {
    title: 'Безопасность',
    text: 'Zero-dependency core. Никаких LLM и сетевых вызовов. Аудируется за час.',
  },
  {
    title: 'Явный выбор банка',
    text: '.bik("044525225") — и вы получаете ПАО Сбербанк. Невалидный БИК вызовет ошибку 400, а не молчаливый откат.',
  },
];
---

<section class="relative border-t border-line py-14 lg:py-16">
  <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
    <div class="grid gap-6 md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] md:items-end">
      <div>
        <p class="kicker">02 / почему validum</p>
        <h2 class="poster-sm mt-4">Больше, чем просто Faker</h2>
      </div>
      <p class="text-fg-muted md:pb-2">Валидность контрольных сумм, каскадные дефолты и работа в закрытом контуре.</p>
    </div>

    <div class="rule mt-8"></div>

    <ul class="mt-0">
      {items.map((item, index) => (
        <li class="grid gap-x-8 gap-y-2 border-b border-line py-6 md:grid-cols-[3rem_minmax(0,1fr)_minmax(0,1fr)] md:items-baseline">
          <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-fg-subtle">0{index + 1}</span>
          <h3 class="text-[19px] font-semibold tracking-tight text-fg">{item.title}</h3>
          <p class="max-w-[38rem] text-sm leading-relaxed text-fg-muted">{item.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
