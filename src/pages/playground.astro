---
import BaseLayout from '../layouts/BaseLayout.astro';
import PlaygroundWizard from '../components/PlaygroundWizard';
---

<BaseLayout title="Playground — Validum">
  <div class="max-w-[1000px] mx-auto px-6 py-16 lg:py-24">

    <div class="mb-12 text-center">
      <div class="text-xs font-mono text-accent tracking-widest mb-2 uppercase">Playground</div>
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight mb-4">Симулятор регистрации в АБС</h1>
      <p class="text-lg text-[var(--text-muted)] max-w-2xl mx-auto">
        Пройдите все шаги создания клиента: от выбора параметров до получения ответа от банковской системы.
        В этом демо используется <strong>Mock-логика</strong> без реального бэкенда.
      </p>
    </div>

    <PlaygroundWizard client:load />

  </div>
</BaseLayout>