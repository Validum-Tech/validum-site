---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Документация">
    <div class="max-w-[1200px] mx-auto px-6 py-12 lg:py-20">
        <div class="grid lg:grid-cols-12 gap-12">

            <!-- Мобильное содержание (виден только на < lg) -->
            <details class="lg:hidden mb-8 rounded-xl border border-line bg-surface-2">
                <summary class="cursor-pointer p-4 font-semibold text-fg flex items-center justify-between select-none list-none">
                    <span>Содержание</span>
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-fg-muted transition-transform [details[open]_&]:rotate-180">
                        <path d="m6 9 6 6 6-6"/>
                    </svg>
                </summary>
                <nav class="px-4 pb-4 flex flex-col gap-1 text-sm">
                    <div class="text-xs font-mono text-fg-muted uppercase tracking-widest mt-2 mb-1">Начало работы</div>
                    <a href="#install" class="py-1.5 text-fg-muted hover:text-accent transition-colors">Установка</a>
                    <a href="#first-request" class="py-1.5 text-fg-muted hover:text-accent transition-colors">Первый запрос</a>
                    <a href="#concepts" class="py-1.5 text-fg-muted hover:text-accent transition-colors">Ключевые концепции</a>

                    <div class="text-xs font-mono text-fg-muted uppercase tracking-widest mt-4 mb-1">Гайды</div>
                    <a href="#guide-cascades" class="py-1.5 text-fg-muted hover:text-accent transition-colors">Каскадные дефолты</a>
                    <a href="#guide-bank" class="py-1.5 text-fg-muted hover:text-accent transition-colors">Выбор банка</a>
                    <a href="#guide-batch" class="py-1.5 text-fg-muted hover:text-accent transition-colors">Пакетная генерация</a>
                    <a href="#guide-allure" class="py-1.5 text-fg-muted hover:text-accent transition-colors">JUnit 5 + Allure</a>
                    <a href="#guide-ed807" class="py-1.5 text-fg-muted hover:text-accent transition-colors">Справочник ЦБ</a>

                    <div class="text-xs font-mono text-fg-muted uppercase tracking-widest mt-4 mb-1">Справочник API</div>
                    <a href="#ref-generate" class="py-1.5 text-fg-muted hover:text-accent transition-colors">Генерация</a>
                    <a href="#ref-batch" class="py-1.5 text-fg-muted hover:text-accent transition-colors">Батчи</a>
                    <a href="#ref-scenarios" class="py-1.5 text-fg-muted hover:text-accent transition-colors">Сценарии</a>
                    <a href="#ref-validate" class="py-1.5 text-fg-muted hover:text-accent transition-colors">Валидация</a>
                    <a href="#ref-cli" class="py-1.5 text-fg-muted hover:text-accent transition-colors">CLI</a>
                    <a href="#ref-java" class="py-1.5 text-fg-muted hover:text-accent transition-colors">Java-библиотека</a>
                </nav>
            </details>

            <aside class="lg:col-span-3 hidden lg:block">
                <div class="sticky top-24 space-y-8">

                    <div>
                        <div class="text-xs font-mono text-fg-muted uppercase tracking-widest mb-3">Начало работы</div>
                        <nav class="flex flex-col space-y-1 border-l border-line">
                            <a href="#install" class="doc-link px-4 py-2 text-sm text-accent border-l-2 border-accent -ml-[1px] bg-accent/5 font-medium transition-colors">Установка</a>
                            <a href="#first-request" class="doc-link px-4 py-2 text-sm text-fg-muted hover:text-fg border-l-2 border-transparent -ml-[1px] transition-colors">Первый запрос</a>
                            <a href="#concepts" class="doc-link px-4 py-2 text-sm text-fg-muted hover:text-fg border-l-2 border-transparent -ml-[1px] transition-colors">Ключевые концепции</a>
                        </nav>
                    </div>

                    <div>
                        <div class="text-xs font-mono text-fg-muted uppercase tracking-widest mb-3">Гайды</div>
                        <nav class="flex flex-col space-y-1 border-l border-line">
                            <a href="#guide-cascades" class="doc-link px-4 py-2 text-sm text-fg-muted hover:text-fg border-l-2 border-transparent -ml-[1px] transition-colors">Каскадные дефолты</a>
                            <a href="#guide-bank" class="doc-link px-4 py-2 text-sm text-fg-muted hover:text-fg border-l-2 border-transparent -ml-[1px] transition-colors">Выбор банка</a>
                            <a href="#guide-batch" class="doc-link px-4 py-2 text-sm text-fg-muted hover:text-fg border-l-2 border-transparent -ml-[1px] transition-colors">Пакетная генерация</a>
                            <a href="#guide-allure" class="doc-link px-4 py-2 text-sm text-fg-muted hover:text-fg border-l-2 border-transparent -ml-[1px] transition-colors">JUnit 5 + Allure</a>
                            <a href="#guide-ed807" class="doc-link px-4 py-2 text-sm text-fg-muted hover:text-fg border-l-2 border-transparent -ml-[1px] transition-colors">Справочник ЦБ</a>
                        </nav>
                    </div>

                    <div>
                        <div class="text-xs font-mono text-fg-muted uppercase tracking-widest mb-3">Справочник API</div>
                        <nav class="flex flex-col space-y-1 border-l border-line">
                            <a href="#ref-generate" class="doc-link px-4 py-2 text-sm text-fg-muted hover:text-fg border-l-2 border-transparent -ml-[1px] transition-colors">Генерация</a>
                            <a href="#ref-batch" class="doc-link px-4 py-2 text-sm text-fg-muted hover:text-fg border-l-2 border-transparent -ml-[1px] transition-colors">Батчи</a>
                            <a href="#ref-scenarios" class="doc-link px-4 py-2 text-sm text-fg-muted hover:text-fg border-l-2 border-transparent -ml-[1px] transition-colors">Сценарии</a>
                            <a href="#ref-validate" class="doc-link px-4 py-2 text-sm text-fg-muted hover:text-fg border-l-2 border-transparent -ml-[1px] transition-colors">Валидация</a>
                            <a href="#ref-cli" class="doc-link px-4 py-2 text-sm text-fg-muted hover:text-fg border-l-2 border-transparent -ml-[1px] transition-colors">CLI</a>
                            <a href="#ref-java" class="doc-link px-4 py-2 text-sm text-fg-muted hover:text-fg border-l-2 border-transparent -ml-[1px] transition-colors">Java-библиотека</a>
                        </nav>
                    </div>

                </div>
            </aside>

            <article class="lg:col-span-9 min-w-0 overflow-hidden">

                <div class="mb-16">
                    <div class="text-xs font-mono text-accent tracking-widest mb-2 uppercase">Документация</div>
                    <h1 class="text-4xl font-bold tracking-tight mb-4">Документация Validum</h1>
                    <p class="text-lg text-fg-muted leading-relaxed">
                        Генератор валидных тестовых данных для российских АБС. Self-hosted, zero-dependency core,
                        детерминированные алгоритмы без LLM.
                    </p>
                </div>

                <div class="h-px w-full bg-line my-12"></div>

                <section id="install" class="mb-16 scroll-mt-24">
                    <h2 class="text-3xl font-semibold mb-6 flex items-center gap-3">
                        <span class="text-accent font-mono text-xl">01</span> Установка
                    </h2>
                    <p class="text-fg-muted mb-6">
                        Validum состоит из 4 модулей: <code>validum-core</code> (zero-dep),
                        <code>validum-api</code> (Spring Boot), <code>validum-cli</code> (Picocli),
                        <code>validum-allure</code> (JUnit 5).
                    </p>

                    <h3 class="text-xl font-semibold mb-3">Docker (рекомендуется)</h3>
                    <p class="text-sm text-fg-muted mb-3">Не требует JDK. Образ ~250 МБ. Мультистейдж сборка.</p>
                    <div class="code-block mb-4">
            <pre><code class="language-bash">git clone https://github.com/Validum-Tech/validum.git
cd validum
docker build -f validum-api/Dockerfile -t validum-api .
docker run -d -p 8080:8080 --name validum validum-api

# Проверка
curl http://localhost:8080/actuator/health</code></pre>
                    </div>

                    <h3 class="text-xl font-semibold mb-3">CLI (fat JAR)</h3>
                    <p class="text-sm text-fg-muted mb-3">Работает offline. Только JDK 21+. ~3 МБ.</p>
                    <div class="code-block mb-4">
            <pre><code class="language-bash">./gradlew :validum-cli:shadowJar
java -jar validum-cli/build/libs/validum.jar --help</code></pre>
                    </div>

                    <h3 class="text-xl font-semibold mb-3">Java-библиотека</h3>
                    <p class="text-sm text-fg-muted mb-3">
                        Публикация в Maven Central запланирована (P1.1). Пока — локальная сборка модуля:
                    </p>
                    <div class="code-block mb-4">
                        <pre><code class="language-bash">./gradlew :validum-core:jar
# артефакт: validum-core/build/libs/validum-core-0.1.0-SNAPSHOT.jar</code></pre>
                    </div>
                </section>

                <section id="first-request" class="mb-16 scroll-mt-24">
                    <h2 class="text-3xl font-semibold mb-6 flex items-center gap-3">
                        <span class="text-accent font-mono text-xl">02</span> Первый запрос
                    </h2>
                    <p class="text-fg-muted mb-4">
                        Сгенерируйте профиль физлица с фиксированным seed для воспроизводимости:
                    </p>
                    <div class="code-block mb-6">
            <pre><code class="language-bash">curl -X POST http://localhost:8080/api/v1/generate/individual \
  -H "Content-Type: application/json" \
  -d '&#123;"seed": 42, "age": 35, "region": "MOSCOW"&#125;'</code></pre>
                    </div>

                    <p class="text-fg-muted mb-3">Ответ:</p>
                    <div class="code-block mb-4">
            <pre><code class="language-json">&#123;
  "fullName": "Зайцев Григорий Григорьевич",
  "gender": "MALE",
  "birthDate": "1991-06-18",
  "age": 35,
  "familyStatus": "Женат/Замужем",
  "passport": &#123;
    "series": "7715",
    "number": "654321",
    "issuedBy": "Отделением УФМС России по г. Москве",
    "issueDate": "2011-06-18",
    "departmentCode": "770-001",
    "type": "RF",
    "country": "RU"
  &#125;,
  "inn": "427624447300",
  "snils": "11223344595",
  "registrationAddress": &#123;
    "postalCode": "125009",
    "city": "Москва",
    "street": "Тверская",
    "formatted": "125009,Москва г,,,,,,Тверская ул,1, ,"
  &#125;,
  "bank": &#123;
    "bik": "044525225",
    "name": "ПАО Сбербанк",
    "corrAccount": "30101810400000000225"
  &#125;,
  "account": "40817810500000012345"
&#125;</code></pre>
                    </div>
                </section>

                <section id="concepts" class="mb-16 scroll-mt-24">
                    <h2 class="text-3xl font-semibold mb-6 flex items-center gap-3">
                        <span class="text-accent font-mono text-xl">03</span> Ключевые концепции
                    </h2>

                    <div class="space-y-4">
                        <div class="p-5 rounded-xl border border-line bg-surface-2">
                            <h3 class="font-semibold mb-2">Детерминизм</h3>
                            <p class="text-sm text-fg-muted">
                                Один и тот же <code>seed</code> → идентичный результат.
                                Это позволяет воспроизводить баги, фиксировать данные в git и проходить аудит.
                            </p>
                        </div>
                        <div class="p-5 rounded-xl border border-line bg-surface-2">
                            <h3 class="font-semibold mb-2">Валидность по умолчанию</h3>
                            <p class="text-sm text-fg-muted">
                                Все контрольные суммы сходятся: ИНН (ФНС), СНИЛС (ПФР), счёт (809-П), ОГРН (ФНС),
                                КПП, ОКПО (Росстат). Порча — только явно через <code>corrupt</code>.
                            </p>
                        </div>
                        <div class="p-5 rounded-xl border border-line bg-surface-2">
                            <h3 class="font-semibold mb-2">Zero-dependency core</h3>
                            <p class="text-sm text-fg-muted">
                                <code>validum-core</code> не тянет ни одной сторонней библиотеки. Только JDK 21.
                                Аудируется за час.
                            </p>
                        </div>
                    </div>
                </section>

                <div class="h-px w-full bg-line my-12"></div>

                <div class="mb-12">
                    <div class="text-xs font-mono text-accent tracking-widest mb-2 uppercase">Гайды</div>
                    <h1 class="text-3xl font-bold tracking-tight">Практические сценарии</h1>
                </div>

                <section id="guide-cascades" class="mb-16 scroll-mt-24">
                    <h2 class="text-2xl font-semibold mb-4">Каскадные дефолты</h2>
                    <p class="text-fg-muted mb-4">
                        Задаёте один параметр — система сама досчитывает связанные поля.
                    </p>
                    <div class="overflow-x-auto rounded-xl border border-line mb-4">
                        <table class="w-full text-sm">
                            <thead class="bg-surface-1 border-b border-line">
                            <tr>
                                <th class="p-3 text-left font-medium text-fg-muted text-xs uppercase">Триггер</th>
                                <th class="p-3 text-left font-medium text-fg-muted text-xs uppercase">Что досчитывается</th>
                            </tr>
                            </thead>
                            <tbody>
                            <tr class="border-b border-line">
                                <td class="p-3 font-mono text-accent text-xs">age=16</td>
                                <td class="p-3 text-fg-muted">Паспорт выдан в 14, familyStatus=SINGLE</td>
                            </tr>
                            <tr class="border-b border-line">
                                <td class="p-3 font-mono text-accent text-xs">age=50</td>
                                <td class="p-3 text-fg-muted">Бессрочный паспорт, выдан в 45</td>
                            </tr>
                            <tr class="border-b border-line">
                                <td class="p-3 font-mono text-accent text-xs">region=MOSCOW</td>
                                <td class="p-3 text-fg-muted">КПП на 77, серия паспорта 77xx, адрес в Москве</td>
                            </tr>
                            <tr class="border-b border-line">
                                <td class="p-3 font-mono text-accent text-xs">categoryClient="ЗАРПЛАТНИК"</td>
                                <td class="p-3 text-fg-muted">accountPackage="ЗАРПЛАТНЫЙ"</td>
                            </tr>
                            <tr class="border-b border-line">
                                <td class="p-3 font-mono text-accent text-xs">organizationType=SE</td>
                                <td class="p-3 text-fg-muted">OKOPF=61, OKFS=14, budget="Бюджетная"</td>
                            </tr>
                            <tr>
                                <td class="p-3 font-mono text-accent text-xs">residencyCountry=TJ</td>
                                <td class="p-3 text-fg-muted">FOREIGN паспорт, гражданство TJ</td>
                            </tr>
                            </tbody>
                        </table>
                    </div>
                </section>

                <section id="guide-bank" class="mb-16 scroll-mt-24">
                    <h2 class="text-2xl font-semibold mb-4">Явный выбор банка</h2>
                    <p class="text-fg-muted mb-4">
                        По умолчанию банк случайный из справочника. Задайте <code>bik</code> для фиксации.
                    </p>
                    <div class="code-block mb-4">
            <pre><code class="language-bash">curl -X POST http://localhost:8080/api/v1/generate/individual \
  -H "Content-Type: application/json" \
  -d '&#123;"seed": 42, "bik": "044525225"&#125;'</code></pre>
                    </div>
                    <p class="text-sm text-fg-muted">
                        Невалидный БИК → <code class="text-danger">HTTP 400</code>
                        с понятным сообщением. Никакого отката на случайный.
                    </p>
                </section>

                <section id="guide-batch" class="mb-16 scroll-mt-24">
                    <h2 class="text-2xl font-semibold mb-4">Пакетная генерация</h2>
                    <p class="text-fg-muted mb-4">
                        До 10 000 профилей за запрос. Первый использует seed, второй seed+1 и т.д.
                    </p>
                    <div class="code-block mb-4">
            <pre><code class="language-bash">curl -X POST http://localhost:8080/api/v1/generate/individual/batch \
  -H "Content-Type: application/json" \
  -d '&#123;"count": 100, "seed": 42, "region": "MOSCOW"&#125;'</code></pre>
                    </div>
                    <p class="text-sm text-fg-muted">
                        Экспорт: <code>?format=json|json-array|csv</code>.
                        CSV — с UTF-8 BOM для Excel.
                    </p>
                </section>

                <section id="guide-allure" class="mb-16 scroll-mt-24">
                    <h2 class="text-2xl font-semibold mb-4">JUnit 5 + Allure</h2>
                    <p class="text-fg-muted mb-4">
                        Автоматически прикладывает профиль в Allure-отчёт.
                    </p>
                    <div class="code-block mb-4">
            <pre><code class="language-java">@ExtendWith(ValidumExtension.class)
class ClientTest &#123;

    @Test
    @ValidumSeed(42)
    void createClient() &#123;
        // Профиль с seed=42 уже в Allure-attachment
    &#125;

    @Test
    @ValidumGenerate(seed = 42, age = 16, region = "MOSCOW")
    void minorClient() &#123; /* ... */ &#125;
&#125;</code></pre>
                    </div>
                </section>

                <section id="guide-ed807" class="mb-16 scroll-mt-24">
                    <h2 class="text-2xl font-semibold mb-4">Полный справочник ЦБ</h2>
                    <p class="text-fg-muted mb-4">
                        По умолчанию встроен топ-30. Для полного ED807 (370 банков):
                    </p>
                    <div class="code-block mb-4">
            <pre><code class="language-bash">java -jar validum.jar fetch-bik -o data/ED807.xml

# В банковском контуре без интернета:
java -jar validum.jar fetch-bik --offline

# Примонтировать при запуске API
docker run -d -p 8080:8080 \
  -v $(pwd)/data/ED807.xml:/app/data/ED807.xml:ro \
  -e VALIDUM_BIK_FILE=/app/data/ED807.xml \
  validum-api</code></pre>
                    </div>
                </section>

                <div class="h-px w-full bg-line my-12"></div>

                <div class="mb-12">
                    <div class="text-xs font-mono text-accent tracking-widest mb-2 uppercase">Справочник API</div>
                    <h1 class="text-3xl font-bold tracking-tight">Полный справочник</h1>
                </div>

                <section id="ref-generate" class="mb-16 scroll-mt-24">
                    <h2 class="text-2xl font-semibold mb-4">Генерация — 3 эндпоинта</h2>
                    <div class="overflow-x-auto rounded-xl border border-line mb-6">
                        <table class="w-full text-sm">
                            <thead class="bg-surface-1 border-b border-line">
                            <tr>
                                <th class="p-3 text-left text-xs uppercase text-fg-muted">Метод</th>
                                <th class="p-3 text-left text-xs uppercase text-fg-muted">Путь</th>
                                <th class="p-3 text-left text-xs uppercase text-fg-muted">Описание</th>
                            </tr>
                            </thead>
                            <tbody>
                            <tr class="border-b border-line">
                                <td class="p-3"><span class="px-2 py-0.5 rounded bg-accent/10 text-accent text-xs font-mono">POST</span></td>
                                <td class="p-3 font-mono text-xs">/api/v1/generate/individual</td>
                                <td class="p-3 text-fg-muted">Профиль ФЛ</td>
                            </tr>
                            <tr class="border-b border-line">
                                <td class="p-3"><span class="px-2 py-0.5 rounded bg-accent/10 text-accent text-xs font-mono">POST</span></td>
                                <td class="p-3 font-mono text-xs">/api/v1/generate/ip</td>
                                <td class="p-3 text-fg-muted">Профиль ИП</td>
                            </tr>
                            <tr>
                                <td class="p-3"><span class="px-2 py-0.5 rounded bg-accent/10 text-accent text-xs font-mono">POST</span></td>
                                <td class="p-3 font-mono text-xs">/api/v1/generate/organization</td>
                                <td class="p-3 text-fg-muted">Профиль ЮЛ (7 ОПФ)</td>
                            </tr>
                            </tbody>
                        </table>
                    </div>

                    <h3 class="text-lg font-semibold mb-2">Параметры ФЛ</h3>
                    <div class="overflow-x-auto rounded-xl border border-line mb-4">
                        <table class="w-full text-xs">
                            <thead class="bg-surface-1"><tr>
                                <th class="p-2 text-left font-medium text-fg-muted">Поле</th>
                                <th class="p-2 text-left font-medium text-fg-muted">Тип</th>
                                <th class="p-2 text-left font-medium text-fg-muted">Описание</th>
                            </tr></thead>
                            <tbody>
                            <tr class="border-t border-line"><td class="p-2 font-mono text-accent">seed</td><td class="p-2 text-fg-muted">long</td><td class="p-2 text-fg-muted">Воспроизводимость</td></tr>
                            <tr class="border-t border-line"><td class="p-2 font-mono text-accent">age</td><td class="p-2 text-fg-muted">int</td><td class="p-2 text-fg-muted">Возраст</td></tr>
                            <tr class="border-t border-line"><td class="p-2 font-mono text-accent">gender</td><td class="p-2 text-fg-muted">enum</td><td class="p-2 text-fg-muted">MALE / FEMALE</td></tr>
                            <tr class="border-t border-line"><td class="p-2 font-mono text-accent">region</td><td class="p-2 text-fg-muted">enum</td><td class="p-2 text-fg-muted">MOSCOW, SPB, MO, KRASNODAR, SVERDLOVSK (5); все 16 — для ЮЛ и батчей</td></tr>
                            <tr class="border-t border-line"><td class="p-2 font-mono text-accent">bik</td><td class="p-2 text-fg-muted">string</td><td class="p-2 text-fg-muted">9 цифр, не найден → 400</td></tr>
                            <tr class="border-t border-line"><td class="p-2 font-mono text-accent">corrupt</td><td class="p-2 text-fg-muted">array</td><td class="p-2 text-fg-muted">INN, SNILS</td></tr>
