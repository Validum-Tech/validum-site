<script>
    document.querySelectorAll<HTMLPreElement>('pre').forEach(pre => {
        const btn = document.createElement('button');
        btn.className = 'copy-btn absolute top-2 right-2 px-2 py-1 text-xs text-fg-muted bg-surface-2 hover:bg-surface-3 rounded transition opacity-0 group-hover:opacity-100 border border-line';
        btn.innerText = 'Copy';
        btn.addEventListener('click', () => {
            const code = pre.querySelector<HTMLElement>('code');
            if (code) {
                navigator.clipboard.writeText(code.innerText).then(() => {
                    btn.innerText = 'Copied!';
                    setTimeout(() => btn.innerText = 'Copy', 2000);
                }).catch(() => {});
            }
        });
        pre.style.position = 'relative';
        pre.classList.add('group');
        pre.appendChild(btn);
    });

    const observer = new IntersectionObserver(entries => {
        entries.forEach(entry => {
            if (entry.intersectionRatio > 0) {
                const id = entry.target.getAttribute('id');
                document.querySelectorAll<HTMLAnchorElement>('.doc-link').forEach(link => {
                    if (link.getAttribute('href') === `#${id}`) {
                        link.classList.add('text-accent', 'border-accent', 'bg-accent/5', 'font-medium');
                        link.classList.remove('text-fg-muted', 'border-transparent');
                    } else {
                        link.classList.remove('text-accent', 'border-accent', 'bg-accent/5', 'font-medium');
                        link.classList.add('text-fg-muted', 'border-transparent');
                    }
                });
            }
        });
    }, { rootMargin: '-20% 0px -70% 0px' });

    document.querySelectorAll<HTMLElement>('section[id]').forEach(s => observer.observe(s));

    document.querySelectorAll<HTMLAnchorElement>('details nav a').forEach(link => {
        link.addEventListener('click', () => {
            const details = link.closest('details');
            if (details) details.open = false;
        });
    });
</script>