<style>
  section h2, section h3 { scroll-margin-top: 6rem; }
  .copy-btn { font-family: var(--font-mono); }
</style>

<script>
  // Copy
  document.querySelectorAll('pre').forEach(pre => {
    const btn = document.createElement('button');
    btn.className = 'copy-btn absolute top-2 right-2 px-2 py-1 text-xs text-[#a1a1aa] bg-white/5 hover:bg-white/10 rounded transition opacity-0 group-hover:opacity-100';
    btn.innerText = 'Copy';
    btn.addEventListener('click', () => {
      const code = pre.querySelector('code');
      if (code) {
        navigator.clipboard.writeText(code.innerText).then(() => {
          btn.innerText = 'Copied!';
          setTimeout(() => btn.innerText = 'Copy', 2000);
        });
      }
    });
    pre.style.position = 'relative';
    pre.classList.add('group');
    pre.appendChild(btn);
  });

  // Скроллспай
  const observer = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if (entry.intersectionRatio > 0) {
        const id = entry.target.getAttribute('id');
        document.querySelectorAll('.doc-link').forEach(link => {
          if (link.getAttribute('href') === `#${id}`) {
            link.classList.add('text-accent', 'border-accent', 'bg-accent/5', 'font-medium');
            link.classList.remove('text-[var(--text-muted)]', 'border-transparent');
          } else {
            link.classList.remove('text-accent', 'border-accent', 'bg-accent/5', 'font-medium');
            link.classList.add('text-[var(--text-muted)]', 'border-transparent');
          }
        });
      }
    });
  }, { rootMargin: '-20% 0px -70% 0px' });

  document.querySelectorAll('section[id]').forEach(s => observer.observe(s));
</script>