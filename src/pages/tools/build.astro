---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TryForm from '../../components/TryForm';
---

<BaseLayout
  title="Соберите набор"
  description="Конструктор набора Validum: команда CLI под ваши параметры и mock-ответ с кодом для Java, cURL и Allure."
>
  <div class="max-w-[1400px] mx-auto px-4 pt-6 pb-2 flex flex-wrap items-center justify-between gap-4">
    <a href="/tools" class="font-mono text-xs text-fg-muted hover:text-accent transition-colors">← Все инструменты</a>
    <div class="flex gap-1 p-1 rounded-xl border border-line bg-surface-1" id="mode-switcher">
      <button type="button" data-mode="cli" class="mode-btn font-mono text-xs px-3 py-1.5 rounded-lg transition-colors" aria-pressed="true">Команда CLI</button>
      <button type="button" data-mode="answer" class="mode-btn font-mono text-xs px-3 py-1.5 rounded-lg transition-colors" aria-pressed="false">Ответ и код</button>
    </div>
  </div>

  <section data-panel="cli">
    <iframe
      src="/tools/build.html"
      title="Конструктор набора"
      data-tool-frame
      class="w-full border-0 block"
      style="min-height: calc(100vh - 6rem)"
      loading="lazy"
    ></iframe>
  </section>

  <section data-panel="answer" class="hidden">
    <div class="max-w-[1200px] mx-auto px-6 py-10">
      <div class="mb-8 p-4 rounded-xl border border-accent/20 bg-accent/5 flex items-start gap-3">
        <div class="text-accent flex-shrink-0 mt-0.5">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
        </div>
        <div>
          <h3 class="font-semibold text-sm mb-1">Это mock-ответ</h3>
          <p class="text-sm text-fg-muted">
            Данные считаются на клиенте и показывают структуру и код. Значения с проверенными контрольными
            суммами даёт продукт — команда собирается на вкладке «Команда CLI».
          </p>
        </div>
      </div>

      <TryForm client:load />
    </div>
  </section>

  <script>
    (function () {
      const switcher = document.getElementById('mode-switcher');
      const buttons = switcher ? switcher.querySelectorAll('button.mode-btn') : [];
      const panels = document.querySelectorAll('[data-panel]');

      function apply(mode) {
        buttons.forEach(function (btn) {
          const active = btn.dataset.mode === mode;
          btn.setAttribute('aria-pressed', String(active));
          btn.className =
            'mode-btn font-mono text-xs px-3 py-1.5 rounded-lg transition-colors ' +
            (active ? 'bg-accent text-accent-fg font-semibold' : 'text-fg-muted hover:text-fg');
        });
        panels.forEach(function (panel) {
          panel.classList.toggle('hidden', panel.dataset.panel !== mode);
        });
      }

      buttons.forEach(function (btn) {
        btn.addEventListener('click', function () {
          apply(btn.dataset.mode || 'cli');
        });
      });

      apply(new URLSearchParams(location.search).get('mode') === 'answer' ? 'answer' : 'cli');

      window.addEventListener('message', function (event) {
        const data = event.data;
        if (!data || data.type !== 'validum-tool-height') return;
        document.querySelectorAll('iframe[data-tool-frame]').forEach(function (frame) {
          if (frame.contentWindow === event.source && data.height > 560) {
            frame.style.height = Math.round(Number(data.height) + 4) + 'px';
          }
        });
      });
    })();
  </script>
</BaseLayout>
