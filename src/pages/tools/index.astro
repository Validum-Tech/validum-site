---
import BaseLayout from '../../layouts/BaseLayout.astro';

const tools = [
  {
    href: '/architecture',
    badge: 'схема',
    thumb: '/tools/thumbs/architecture.png',
    title: 'Как устроен Validum',
    text: 'Модули, точки входа, источники данных и форматы выдачи — на одной интерактивной схеме.',
    action: 'Открыть схему',
  },
  {
    href: '/tools/anatomy',
    badge: 'интерактив',
    thumb: '/tools/thumbs/anatomy.png',
    title: 'Анатомия одной записи',
    text: 'Один профиль и шесть слоёв: что за поле, откуда значение, какое правило и что отобьёт в АБС.',
    action: 'Разобрать запись',
  },
  {
    href: '/tools/check',
    badge: 'инструмент',
    thumb: '/tools/thumbs/check.png',
    title: 'Проверка реквизитов',
    text: 'Вставьте свои ИНН, СНИЛС, счёт или карту — покажем, сходится ли контрольная сумма и что поправить.',
    action: 'Проверить значение',
  },
  {
    href: '/tools/build',
    badge: 'инструмент',
    thumb: '/tools/thumbs/build.png',
    title: 'Соберите набор за минуту',
    text: 'Сущность, возраст, регион, документы, карты и формат — на выходе JSON, строка CSV и готовая команда.',
    action: 'Собрать набор',
  },
  {
    href: '/tools/pipeline',
    badge: 'схема',
    thumb: '/tools/thumbs/pipeline.png',
    title: 'Откуда берутся данные',
    text: 'КЛАДР, ОКВЭД и справочник ЦБ внутри продукта; слева источники, справа — форматы выдачи.',
    action: 'Смотреть пайплайн',
  },
];
---

<BaseLayout
  title="Инструменты"
  description="Интерактивные схемы и инструменты Validum: анатомия записи, проверка реквизитов, конструктор набора, пайплайн данных."
>
  <section class="max-w-6xl mx-auto px-6 pt-16 pb-10">
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent mb-4">Инструменты</p>
    <h1 class="text-4xl sm:text-5xl font-bold tracking-tight mb-4">Посмотрите, как это работает</h1>
    <p class="text-fg-muted max-w-2xl text-lg">
      Пять страниц без установки: схема архитектуры, разбор одной записи, проверка ваших реквизитов,
      конструктор набора и путь данных от справочников ЦБ до CSV и SQL.
    </p>

    <div class="grid gap-5 mt-10 sm:grid-cols-2">
      {tools.map((tool, index) => (
        <a
          href={tool.href}
          class:list={[
            "group flex flex-col overflow-hidden rounded-2xl border border-line bg-surface-1 transition-colors hover:border-accent/60",
            index === tools.length - 1 && "sm:col-span-2 sm:flex-row",
          ]}
        >
          {tool.thumb && (
            <div class:list={[
              "relative aspect-[2/1] overflow-hidden border-b border-line bg-surface-0",
              index === tools.length - 1 && "sm:aspect-auto sm:w-[46%] sm:shrink-0 sm:border-b-0 sm:border-r",
            ]}>
              <img
                src={tool.thumb}
                alt={`Превью: ${tool.title}`}
                loading="lazy"
                width="794"
                height="397"
                class="h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.03]"
              />
            </div>
          )}
          <div class:list={["p-6", index === tools.length - 1 && "sm:flex sm:flex-col sm:justify-center"]}>
          <div class="flex items-center gap-3 mb-3">
            <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-accent border border-accent/40 rounded px-2 py-0.5">
              {tool.badge}
            </span>
          </div>
          <h2 class="text-xl font-semibold mb-2">{tool.title}</h2>
          <p class="text-sm text-fg-muted mb-4">{tool.text}</p>
          <span class="font-mono text-xs text-accent group-hover:text-accent-light transition-colors">
            {tool.action} →
          </span>
          </div>
        </a>
      ))}
    </div>

    <p class="mt-8 max-w-3xl text-sm leading-relaxed text-fg-subtle">
      Документация отвечает «как вызвать», инструменты — «как это выглядит и почему проходит»:
      ИНН, СНИЛС, ОГРН, ОГРНИП, КПП, ОКПО и счёт по письму № 515 проверяются теми же алгоритмами,
      что в продукте. Mock-ответ генератора и код подключения — на вкладке «Ответ и код»
      в <a href="/tools/build?mode=answer" class="text-accent transition-colors hover:text-accent-light">конструкторе набора</a>;
      подробности — в <a href="/docs" class="text-accent transition-colors hover:text-accent-light">документации</a>.
    </p>
  </section>
</BaseLayout>
