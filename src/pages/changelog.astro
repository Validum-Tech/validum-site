---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="История версий">
  <div class="max-w-[800px] mx-auto px-6 py-16 lg:py-24">
    <div class="mb-16">
      <div class="text-xs font-mono text-accent tracking-widest mb-2 uppercase">Релизы</div>
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight mb-4">История версий</h1>
    </div>

    <div class="border-l-2 border-accent/30 pl-8 space-y-12">
      <div class="relative">
        <div class="absolute -left-[41px] top-1 w-5 h-5 rounded-full bg-accent border-4 border-surface-0"></div>
        <div class="flex items-center gap-4 mb-3 flex-wrap">
          <h2 class="text-2xl font-bold font-mono">v0.1.0</h2>
          <span class="px-2 py-0.5 rounded-full bg-accent/10 text-accent text-xs font-mono border border-accent/20">Текущая</span>
          <span class="text-sm text-fg-muted font-mono">Октябрь 2026</span>
        </div>
        <p class="text-fg-muted mb-4">Первый публичный релиз. Apache 2.0.</p>
        <ul class="space-y-2 text-sm text-fg-muted">
          <li class="flex gap-2"><span class="text-accent">+</span> <code>validum-core</code> — zero-dependency ядро</li>
          <li class="flex gap-2"><span class="text-accent">+</span> <code>validum-api</code> — Spring Boot 3.5.7, 14 эндпоинтов</li>
          <li class="flex gap-2"><span class="text-accent">+</span> <code>validum-cli</code> — fat JAR ~5 МБ, Picocli</li>
          <li class="flex gap-2"><span class="text-accent">+</span> <code>validum-allure</code> — JUnit 5 Extension</li>
          <li class="flex gap-2"><span class="text-accent">+</span> 370 банков ЦБ РФ (ED807 + топ-30)</li>
          <li class="flex gap-2"><span class="text-accent">+</span> 7 ОПФ ЮЛ, 3.8 млн ФИО, 320 адресов</li>
          <li class="flex gap-2"><span class="text-accent">+</span> 8 валидаторов, каскадные дефолты, явный выбор банка</li>
          <li class="flex gap-2"><span class="text-accent">+</span> 574 теста зелёных</li>
        </ul>
      </div>
    </div>
  </div>
</BaseLayout>