---
import BaseLayout from '../layouts/BaseLayout.astro';

const stats = [
  { value: '4', label: 'модуля' },
  { value: '19', label: 'эндпоинтов REST' },
  { value: '10', label: 'команд CLI' },
  { value: '912', label: 'тестов' },
];

const modules = [
  { name: 'validum-core', note: 'Java 17+ · ноль зависимостей' },
  { name: 'validum-api', note: 'Spring Boot 4.1.2 · :8080' },
  { name: 'validum-cli', note: 'Picocli · fat-jar ~15 МБ' },
  { name: 'validum-allure', note: 'JUnit 5 Extension' },
];

const cards = [
  {
    dot: 'bg-accent',
    title: 'Четыре точки входа',
    items: [
      'REST API: <code>/api/v1/generate</code>, <code>/validate</code>, <code>/scenarios</code>, Swagger UI и Actuator',
      'Java-библиотека: генераторы и валидаторы вызываются напрямую, без Spring',
      'CLI: fat-jar <code>validum</code> — generate (в т. ч. <code>documents</code>), fill, validate, participants, scenarios, export ED807/ED808, fetch-bik, version',
      'Allure: <code>@ValidumSeed</code> и <code>@ValidumGenerate</code> кладут профиль в отчёт JSON-вложением',
    ],
  },
  {
    dot: 'bg-accent-light',
    title: 'Ядро и каскадные дефолты',
    items: [
      '<code>seed</code> + <code>asOf</code> → воспроизводимый профиль ФЛ, ИП или ЮЛ (не зависит от календарной даты)',
      'Не задано — выводится: возраст 19, ОПФ LLC, КПП по региону, счёт по категории клиента',
      '8 валидаторов: ИНН, СНИЛС, ОГРН, ОГРНИП, КПП, ОКПО, БИК, счёт по 809-П',
      'Счета: 12 типов ЦБ (<code>AccountType</code>), контрольный ключ по письму ЦБ № 515 — зависит от БИК подразделения',
      'ДУЛ: 11 видов документов (СПДУЛ ФНС) с правилами совместимости',
      'SAME_FOR_ALL: регистрация и проживание совпадают по умолчанию',
    ],
  },
  {
    dot: 'bg-accent/50',
    title: 'Данные и справочники',
    items: [
      'ED807.xml: 1360 участников ЦБ, фильтр PtType=20 → около 370 банков',
      'Справочник БИК обязателен: <code>VALIDUM_BIK_FILE</code> или <code>data/ED807.xml</code>; без файла — 503 <code>bik_source_missing</code>, демо-набора нет',
      'ОКВЭД-2: 3069 кодов (ОК 029-2014) у ЮЛ и ИП — код и наименование; явный код проверяется по справочнику',
      'Ресурсы: адреса из КЛАДР (90 субъектов, ~125 тыс. населённых пунктов, ~2 млн улиц), 100 + 190 имён, 310 тайных слов, 1 менеджер',
      'CSV: UTF-8 с BOM, разделитель «,», CRLF, RFC 4180',
    ],
  },
  {
    dot: 'bg-accent-dark',
    title: 'Сборка и поставка',
    items: [
      'Gradle 9.9.1 · Java 17+ (все модули) · 4 модуля · configuration-cache',
      'CI: ubuntu + Corretto 21, <code>./gradlew build</code>, отчёты тестов в артефактах',
      '912 тестов: 682 core · 92 api · 117 cli · 21 allure',
      'Docker: multi-stage образ, порт 8080, <code>./data:/app/data:ro</code>',
    ],
  },
];
---

<BaseLayout title="Архитектура" description="Как устроен Validum: четыре модуля Gradle, 19 REST-эндпоинтов, 10 команд CLI, core без зависимостей и справочник ЦБ как единственный источник БИК.">
  <div class="mx-auto max-w-[1280px] px-6 py-16 lg:px-10 lg:py-20">

    <div class="mb-12">
      <p class="kicker">Архитектура</p>
      <a href="/tools" class="mt-4 inline-flex font-mono text-[11px] uppercase tracking-[0.14em] text-fg-subtle transition-colors hover:text-accent">← Все инструменты</a>
      <h1 class="poster mt-5">Как устроен Validum</h1>
      <div class="rule mt-7 max-w-xl"></div>
      <p class="mt-6 max-w-2xl text-[16px] leading-relaxed text-fg-muted">
        Четыре модуля, одно ядро без зависимостей и три входа: REST, CLI и Java-библиотека.
        Слева — QA и автотесты, справа — генераторы, сценарии, валидаторы и справочник БИК ЦБ.
      </p>
    </div>

    <div class="mb-10 grid grid-cols-2 gap-px bg-line md:grid-cols-4">
      {stats.map(s => (
        <div class="bg-surface-0 p-5">
          <div class="num-xl text-fg">{s.value}</div>
          <div class="label mt-2">{s.label}</div>
        </div>
      ))}
    </div>

    <div class="-mx-6 mb-4 flex items-center gap-2 overflow-x-auto px-6 pb-1 lg:mx-0 lg:flex-wrap lg:overflow-visible lg:px-0" id="diagram-chips">
      <span class="mr-1 shrink-0 font-mono text-[10px] uppercase tracking-[0.14em] text-fg-subtle">Подсветить модуль:</span>
      {[
        ['qa', 'QA и автотесты'],
        ['api', 'REST API'],
        ['cli', 'CLI'],
        ['allure', 'Allure'],
        ['core', 'validum-core'],
        ['gen', 'Генераторы'],
        ['scen', 'Сценарии'],
        ['val', 'Валидаторы'],
        ['export', 'Экспорт'],
        ['bank', 'Источник БИК'],
        ['ed807', 'ED807.xml'],
        ['res', 'Ресурсы'],
      ].map(([id, label]) => (
        <button
          type="button"
          data-focus={id}
          class="shrink-0 border border-line bg-surface-0 px-3 py-2 font-mono text-[11px] uppercase tracking-[0.1em] text-fg-subtle transition-colors hover:border-fg/30 hover:text-fg aria-pressed:border-accent/60 aria-pressed:text-accent"
        >{label}</button>
      ))}
      <button
        type="button"
        data-focus=""
        class="border border-line bg-surface-0 px-3 py-1.5 font-mono text-[11px] uppercase tracking-[0.1em] text-fg-subtle transition-colors hover:border-accent/50 hover:text-accent"
      >Сбросить</button>
    </div>

    <div class="hairline group relative overflow-hidden">
      <iframe
        id="diagram-frame"
        src="/diagrams/validum-architecture.html?theme=dark&embed=1"
        title="Интерактивная диаграмма архитектуры Validum"
        class="hidden h-[640px] w-full border-0 md:block lg:h-[760px]"
        loading="lazy"
      ></iframe>

      <a href="/diagrams/validum-architecture.html?theme=dark" class="group relative block md:hidden" aria-label="Открыть схему архитектуры на весь экран">
        <img src="/tools/thumbs/architecture.png" alt="Схема архитектуры Validum: три входа, ядро и источники данных" width="794" height="471" class="w-full" loading="lazy" />
        <span class="absolute inset-x-0 bottom-0 flex items-center justify-between gap-3 bg-surface-0/95 px-4 py-3 font-mono text-[10px] uppercase tracking-[0.14em] text-fg-subtle">
          открыть схему на весь экран
          <span class="text-accent">→</span>
        </span>
      </a>
    </div>

    <div class="mt-4 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-fg-subtle">
      <a href="/diagrams/validum-architecture.html?theme=dark" class="inline-flex min-h-6 items-center gap-1.5 text-accent hover:text-accent-light transition-colors duration-150">
        Открыть диаграмму на весь экран
        <svg class="size-3.5" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M5 11 11 5M6 5h5v5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
      <span>Схема отражает структуру репозитория: 4 модуля Gradle, 19 эндпоинтов, 10 команд CLI, 912 тестов.</span>
    </div>

    <script>
      (function () {
        const frame = document.getElementById('diagram-frame') as HTMLIFrameElement | null;
        const chips = document.querySelectorAll<HTMLButtonElement>('#diagram-chips button[data-focus]');
        if (!frame) return;

        function send(id: string) {
          frame.contentWindow?.postMessage({ type: 'validum-diagram-focus', id }, '*');
          chips.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.focus === id)));
        }

        chips.forEach((button) => {
          button.addEventListener('click', () => send(button.dataset.focus ?? ''));
        });

        // если во фрейме ещё не загрузился скрипт — повторим после load
        frame.addEventListener('load', () => {
          const pressed = document.querySelector<HTMLButtonElement>('#diagram-chips button[aria-pressed="true"]');
          if (pressed?.dataset.focus) send(pressed.dataset.focus);
        });
      })();
    </script>

    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mt-4">
      <p class="text-xs font-mono text-fg-muted">
        Диаграмма · 19 эндпоинтов · 10 команд · 4 модуля · 912 тестов
      </p>
      <div class="flex flex-wrap items-center gap-3">
        <a href="/diagrams/validum-architecture.html?theme=dark"
           class="btn-hairline">
          Полная версия ↗
        </a>
        <a href="/docs#ref-generate"
           class="inline-flex items-center gap-2 text-sm text-accent hover:text-accent-light transition-colors">
          Справочник API →
        </a>
      </div>
    </div>

    <p class="mt-3 text-xs text-fg-muted leading-relaxed">
      В полной версии — светлая и тёмная темы, масштаб, экспорт в PNG, SVG и WebM.
      На узких экранах диаграмму можно прокрутить по горизонтали.
    </p>

    <div class="rule my-12"></div>

    <div class="mb-12 grid grid-cols-2 gap-px bg-line md:grid-cols-4">
      {modules.map(m => (
        <div class="bg-surface-0 p-5">
          <div class="font-mono text-[13px] text-fg">{m.name}</div>
          <div class="mt-1.5 text-xs text-fg-subtle">{m.note}</div>
        </div>
      ))}
    </div>

    <div class="grid gap-px bg-line md:grid-cols-2">
      {cards.map(card => (
        <div class="bg-surface-0 p-7">
          <div class="flex items-center gap-3 mb-4">
            <span class={`h-2 w-2 ${card.dot}`}></span>
            <h2 class="text-[17px] font-semibold tracking-tight">{card.title}</h2>
          </div>
          <ul class="space-y-2 text-sm text-fg-muted leading-relaxed">
            {card.items.map(item => (
              <li class="flex gap-2">
                <span class="text-accent shrink-0">·</span>
                <span set:html={item}></span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-12 flex flex-col items-start justify-between gap-4 border border-line bg-surface-0 p-7 sm:flex-row sm:items-center">
      <div>
        <h3 class="text-[17px] font-semibold tracking-tight">Посмотреть исходники</h3>
        <p class="mt-2 text-sm text-fg-muted">Четыре Gradle-модуля, тесты и Dockerfile — в открытом репозитории.</p>
      </div>
      <a href="https://github.com/Validum-Tech/validum" target="_blank" rel="noopener"
         class="btn-solid shrink-0">
        GitHub ↗
      </a>
    </div>

  </div>

</BaseLayout>
