---
import BaseLayout from '../layouts/BaseLayout.astro';

const items = [
  { status: "done", tag: "P0.1 — P0.3", title: "Данные в ресурсах", desc: "ФИО (3.8 млн), адреса из КЛАДР (90 субъектов), email/секретные слова/менеджеры — вынесены из кода." },
  { status: "done", tag: "P1.2 — P1.4", title: "Batch, Validation API, экспорт", desc: "3 batch-эндпоинта (до 10 000 профилей), 8 валидаторов, CSV / JSON Array." },
  { status: "done", tag: "P2.2 — P2.3", title: "7 ОПФ + ОКПО/ОГРНИП", desc: "LLC, JSC, PJSC, NCO, FOUNDATION, SE (ГУП), ME (МУП). 8 валидаторов всего." },
  { status: "done", tag: "P3.1 — P3.3", title: "CLI, Allure, .bik", desc: "Fat JAR на Picocli, JUnit 5 Extension, явный выбор банка. 721 тест." },
  { status: "done", tag: "P4.1", title: "Импорт CSV (дозаполнение)", desc: "Свой CSV дозаполняется валидными данными: REST /fill, CLI fill, документы в трёх режимах — inline, JSON, split." },
  { status: "done", tag: "Октябрь", title: "Участники ЦБ, счета по 515, ДУЛ, ED807/ED808", desc: "17 типов участников, 12 типов счетов с ключом по письму ЦБ № 515, 11 видов ДУЛ, 9 сценариев, экспорт XML ЦБ, Docker. 721 тест." },
  { status: "done", tag: "P1.1", title: "Maven Central", desc: "Пакеты io.github.validum-tech:validum-core и validum-allure публикуются из CI; текущая версия 0.4.1." },
  { status: "done", tag: "P2.4", title: "ЮЛ: банк и счёт", desc: "Юридическое лицо получает банк и расчётный счёт — покрытие как у ФЛ и ИП." },
  { status: "plan", tag: "P3.4", title: "Mock API по OpenAPI", desc: "Mock-сервер для сквозных автотестов. Транзакции (платёжные поручения, ED101/ED210/211) по решению владельца не планируются." },
  { status: "plan", tag: "Эмулятор ЦБ", title: "Приём ED807/ED808", desc: "Локальный приёмник сообщений ЦБ для сквозных автотестов. Отложен по решению владельца." },
];
---

<BaseLayout title="Планы развития" description="Планы развития Validum: что уже работает в 0.5.0, что запланировано в 0.4.x и дальше, и что сознательно не делаем (транзакции ED101/ED210/ED211).">
  <div class="mx-auto max-w-[1000px] px-6 py-16 lg:px-10 lg:py-20">
    <div class="mb-12">
      <p class="kicker">Дорожная карта</p>
      <h1 class="poster mt-4">Что сделано, что дальше</h1>
      <div class="rule mt-7 max-w-xl"></div>
      <p class="mt-6 text-[16px] text-fg-muted">Открытый план развития. Без обещаний «в Q3». Только факты.</p>
    </div>

    <div class="space-y-px bg-line">
      {items.map(item => (
          <div class:list={["flex items-start gap-5 p-6 transition-colors", item.status === 'next' ? 'bg-metric-surface' : 'bg-surface-0 hover:bg-surface-1']}>

            <div class:list={["flex h-8 w-8 flex-shrink-0 items-center justify-center border",
              item.status === 'done' ? 'border-accent/40 text-accent' :
                  item.status === 'next' ? 'border-line text-fg' :
                      'border-line text-fg-subtle']}>
              {item.status === 'done' ? (
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              ) : item.status === 'next' ? (
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              ) : (
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              )}
            </div>

            <div class="flex-1">
              <div class="flex items-center gap-3 mb-2 flex-wrap">
              <span class:list={["label border px-2 py-0.5",
                item.status === 'done' ? 'border-accent/30 text-accent' :
                    item.status === 'next' ? 'border-line text-fg' :
                        'border-line text-fg-subtle']}>
                {item.status === 'done' ? 'Готово' : item.status === 'next' ? 'Дальше' : 'План'}
              </span>
                <span class="font-mono text-[11px] uppercase tracking-[0.12em] text-fg-subtle">{item.tag}</span>
              </div>
              <h3 class="text-[17px] font-semibold tracking-tight">{item.title}</h3>
              <p class="mt-1.5 text-sm leading-relaxed text-fg-muted">{item.desc}</p>
            </div>
          </div>
      ))}
    </div>
  </div>
</BaseLayout>