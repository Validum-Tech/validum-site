---
import '../styles/global.css';
import { SITE_VERSION } from '../lib/content-contract.mjs';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = "Open-source генератор тестовых данных для российских АБС. ИНН, СНИЛС, 809-П, около 370 банков.",
  ogImage = "/og/cover.png"
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://validum.tech").toString();
const ogImageUrl = new URL(ogImage, Astro.site ?? "https://validum.tech").toString();
---

<!DOCTYPE html>
<html lang="ru" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | Validum</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Validum" />
  <meta property="og:locale" content="ru_RU" />
  <meta property="og:title" content={`${title} | Validum`} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={`${title} | Validum`} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />

  <link rel="preload" as="font" type="font/woff2" href="/fonts/inter-cyrillic-400-normal.woff2" crossorigin="anonymous" />
  <link rel="preload" as="font" type="font/woff2" href="/fonts/inter-cyrillic-700-normal.woff2" crossorigin="anonymous" />
  <meta name="generator" content={`Validum ${SITE_VERSION}`} />
</head>
<body>
  <a href="#main" class="skip-link">Перейти к содержимому</a>
<Header />
<main id="main" tabindex="-1">
  <slot />
</main>
<Footer />
</body>
</html>